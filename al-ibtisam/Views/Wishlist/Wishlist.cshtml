@model List<al_ibtisam.Models.Product>
@{
    ViewData["Title"] = "My Wishlist";
    Layout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=League+Spartan:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .wishlist-page {
        font-family: 'Poppins', sans-serif;
        background: #E5FBFF;
        padding: 30px 0 60px;
        min-height: 60vh;
    }

    .wishlist-title {
        font-size: 26px;
        font-weight: 700;
        color: #028EA5;
        margin: 0 0 6px;
    }

    .wishlist-sub {
        font-size: 14.5px;
        color: #134856;
        margin: 0 0 28px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
    }

    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .wishlist-card {
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform .2s, box-shadow .2s;
        display: flex;
        flex-direction: column;
        min-width: 0;
        position: relative;
    }

        .wishlist-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(2, 142, 165, 0.15);
        }

    .wishlist-img-wrap {
        position: relative;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        background: #f3f3f3;
    }

        .wishlist-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .4s;
        }

    .wishlist-card:hover .wishlist-img-wrap img {
        transform: scale(1.05);
    }

    .discount-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: #86D200;
        color: #134856;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 3px;
        z-index: 2;
        letter-spacing: .3px;
    }

    .remove-wishlist {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        border: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 3;
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
        color: #86D200;
        font-size: 15px;
        transition: background .2s, color .2s, transform .15s;
    }

        .remove-wishlist:hover {
            background: #86D200;
            color: #134856;
            transform: scale(1.05);
        }

    .wishlist-info {
        padding: 10px 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .wishlist-name {
        font-size: 13.5px;
        font-weight: 600;
        color: #134856;
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 36px;
    }

    .wishlist-price {
        font-size: 14px;
        font-weight: 700;
        color: #FFAA0D;
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 6px;
        flex-wrap: wrap;
    }

    .wishlist-old-price {
        font-size: 12px;
        color: #6c8a93;
        text-decoration: line-through;
        font-weight: 400;
    }

    .add-to-cart-btn {
        margin-top: 8px;
        height: 38px;
        border: 1.5px solid #86D200;
        background: #fff;
        color: #134856;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s, color .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .add-to-cart-btn:hover {
            background: #86D200;
            color: #134856;
        }

    /* ================= EMPTY STATE (Fixed) ================= */
    .empty-wishlist {
        text-align: center;
        padding: 70px 20px;
        background: #fff;
        border-radius: 12px;
        border: 1px dashed #b0d4dc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .empty-wishlist i.empty-icon {
        font-size: 48px;
        color: #86D200;
        margin-bottom: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .empty-wishlist h4 {
        font-size: 20px;
        font-weight: 700;
        color: #134856;
        margin: 0 0 10px;
        line-height: 1.3;
        font-family: 'Poppins', sans-serif;
    }

    .empty-wishlist p {
        font-size: 14px;
        color: #6c8a93;
        margin: 0 0 26px;
        line-height: 1.5;
        max-width: 400px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
    }

    .empty-wishlist a.btn-continue {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 48px;
        padding: 0 26px;
        background: #86D200;
        color: #134856;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .3px;
        line-height: 1;
        transition: background .2s, color .2s;
        white-space: nowrap;
    }

        .empty-wishlist a.btn-continue i {
            font-size: 14px;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 0;
            color: inherit;
        }

        .empty-wishlist a.btn-continue:hover {
            background: #134856;
            color: #fff;
        }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 1199.98px) {
        .wishlist-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .wishlist-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .wishlist-page {
            padding: 20px 0 40px;
        }

        .wishlist-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .wishlist-title {
            font-size: 22px;
        }

        .empty-wishlist {
            padding: 50px 18px;
        }

        .empty-wishlist i.empty-icon {
            font-size: 40px;
            margin-bottom: 16px;
        }

        .empty-wishlist h4 {
            font-size: 18px;
        }

        .empty-wishlist p {
            font-size: 13.5px;
            margin-bottom: 22px;
        }

        .empty-wishlist a.btn-continue {
            height: 44px;
            padding: 0 22px;
            font-size: 13px;
        }
    }

    @@media (max-width: 480px) {
        .wishlist-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .wishlist-name {
            font-size: 12.5px;
            min-height: 34px;
        }

        .wishlist-price {
            font-size: 13px;
        }

        .remove-wishlist {
            width: 30px;
            height: 30px;
            font-size: 13px;
        }
    }
</style>

<div class="container wishlist-page">
    <h1 class="wishlist-title">My Wishlist</h1>
    <p class="wishlist-sub">@(Model?.Count ?? 0) products saved in your wishlist</p>

    @if (Model != null && Model.Any())
    {
        <div class="wishlist-grid">
            @foreach (var product in Model)
            {
                <div class="wishlist-card" data-product-id="@product.Id">
                    <div class="wishlist-img-wrap">
                        @if (product.DiscountPercent.HasValue && product.DiscountPercent > 0)
                        {
                            <span class="discount-badge">@product.DiscountPercent%</span>
                        }
                        <button type="button" class="remove-wishlist" data-product-id="@product.Id" aria-label="Remove from wishlist">
                            <i class="fa-solid fa-heart"></i>
                        </button>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                        </a>
                    </div>
                    <div class="wishlist-info">
                        <h3 class="wishlist-name">@product.Name</h3>
                        <p class="wishlist-price">
                            ৳@product.Price.ToString("0")
                            @if (product.OldPrice.HasValue && product.OldPrice > product.Price)
                            {
                                <span class="wishlist-old-price">৳@product.OldPrice.Value.ToString("0")</span>
                            }
                        </p>
                        <button type="button" class="add-to-cart-btn" data-product-id="@product.Id">
                            <i class="fa-solid fa-bag-shopping"></i> Add to Cart
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-wishlist">
            <i class="fa-regular fa-heart empty-icon"></i>
            <h4>Your wishlist is empty</h4>
            <p>Save your favourite products here and shop them later.</p>
            <a href="/" class="btn-continue">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Continue Shopping</span>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // ==========================================
            // Remove from wishlist
            // ==========================================
            document.querySelectorAll('.remove-wishlist').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var id = btn.getAttribute('data-product-id');
                    if (!id) return;

                    fetch('/Wishlist/Remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: parseInt(id) })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) {
                            var card = btn.closest('.wishlist-card');
                            if (card) {
                                card.style.transition = 'opacity .3s, transform .3s';
                                card.style.opacity = '0';
                                card.style.transform = 'scale(.9)';
                                setTimeout(function () {
                                    card.remove();
                                    var remaining = document.querySelectorAll('.wishlist-card').length;
                                    var sub = document.querySelector('.wishlist-sub');
                                    if (sub) sub.textContent = remaining + ' products saved in your wishlist';

                                    var badge = document.getElementById('wishlistCountBadge');
                                    if (badge) badge.textContent = data.count;
                                    var badgeM = document.getElementById('wishlistCountBadgeMobile');
                                    if (badgeM) badgeM.textContent = data.count;

                                    if (remaining === 0) location.reload();
                                }, 300);
                            }
                        }
                    })
                    .catch(function (err) { console.error(err); });
                });
            });

            // ==========================================
            // Add to Cart (Real API)
            // ==========================================
            document.querySelectorAll('.add-to-cart-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var id = btn.getAttribute('data-product-id');
                    if (!id) return;

                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding...';

                    fetch('/Cart/Add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: parseInt(id), size: '', quantity: 1 })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        btn.disabled = false;
                        if (data.success) {
                            btn.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
                            btn.style.background = '#134856';
                            btn.style.color = '#fff';
                            btn.style.borderColor = '#134856';

                            if (window.refreshCartBadge) window.refreshCartBadge();

                            setTimeout(function () {
                                btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> Add to Cart';
                                btn.style.background = '';
                                btn.style.color = '';
                                btn.style.borderColor = '';
                            }, 1400);
                        } else {
                            btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> Add to Cart';
                        }
                    })
                    .catch(function (err) {
                        console.error(err);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa-solid fa-bag-shopping"></i> Add to Cart';
                    });
                });
            });
        })();
    </script>
}