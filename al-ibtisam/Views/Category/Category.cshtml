@model List<al_ibtisam.Models.Product>
@{
    ViewData["Title"] = ViewBag.CategoryName;
    Layout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=League+Spartan:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    /* ================= PAGE ================= */
    .category-page {
        font-family: 'Poppins', sans-serif;
        background: #E5FBFF;
        padding: 20px 0 60px;
    }

    /* ================= BREADCRUMB ================= */
    .breadcrumb-area {
        font-size: 14px;
        color: #134856;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

        .breadcrumb-area a {
            color: #134856;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .breadcrumb-area a:hover {
                color: #028EA5;
            }

        .breadcrumb-area i {
            font-size: 11px;
            color: #028EA5;
        }

    /* ================= LAYOUT ================= */
    .category-layout {
        display: flex;
        gap: 24px;
        align-items: flex-start;
    }

    /* ================= SIDEBAR ================= */
    .sidebar {
        flex: 0 0 240px;
        max-width: 240px;
        background: #fff;
        border-radius: 8px;
        padding: 18px 16px;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
        align-self: flex-start;
    }

        .sidebar h4 {
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid #E5FBFF;
            color: #028EA5;
        }

    /* Category list */
    .category-list {
        list-style: none;
        padding: 0;
        margin: 0 0 28px 0;
        max-height: 620px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #b0d4dc transparent;
    }

        .category-list::-webkit-scrollbar {
            width: 6px;
        }

        .category-list::-webkit-scrollbar-thumb {
            background: #b0d4dc;
            border-radius: 3px;
        }

        .category-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .category-list li {
            margin-bottom: 2px;
        }

        .category-list a {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14.5px;
            color: #134856;
            text-decoration: none;
            padding: 7px 4px;
            transition: color .2s;
            border-radius: 4px;
        }

            .category-list a:hover {
                color: #028EA5;
            }

            .category-list a.active {
                color: #028EA5;
                font-weight: 600;
            }

            .category-list a::before {
                content: "";
                flex: 0 0 8px;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #b0d4dc;
                display: inline-block;
                transition: background .2s;
            }

            .category-list a:hover::before {
                background: #028EA5;
            }

            .category-list a.active::before {
                background: #028EA5;
            }

    /* New products sidebar */
    .new-products-sidebar h4 {
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E5FBFF;
        color: #028EA5;
    }

    .new-product-item {
        display: flex;
        gap: 10px;
        margin-bottom: 14px;
        text-decoration: none;
        color: inherit;
        align-items: center;
    }

        .new-product-item:last-child {
            margin-bottom: 0;
        }

        .new-product-item img {
            flex: 0 0 56px;
            width: 56px;
            height: 56px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #E5FBFF;
            background: #f3f3f3;
        }

    .new-product-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

        .new-product-info h5 {
            font-size: 13px;
            font-weight: 600;
            margin: 0 0 3px 0;
            color: #134856;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .new-product-info span {
            font-size: 13px;
            color: #FFAA0D;
            font-weight: 700;
        }

    /* ================= PRODUCT GRID ================= */
    .product-grid {
        flex: 1 1 auto;
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .product-card {
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform .2s, box-shadow .2s;
        display: flex;
        flex-direction: column;
        min-width: 0;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(2, 142, 165, 0.15);
        }

    .product-img-wrap {
        position: relative;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        background: #f3f3f3;
    }

        .product-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .4s;
        }

    .product-card:hover .product-img-wrap img {
        transform: scale(1.05);
    }

    /* Discount Badge - Action Color #86D200 */
    .discount-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: #86D200;
        color: #134856;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 3px;
        z-index: 2;
        letter-spacing: .3px;
    }

    /* ================= WISHLIST BUTTON ================= */
    .wishlist-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 3;
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
        color: #134856;
        font-size: 16px;
        transition: background .2s, color .2s, transform .15s;
    }

        .wishlist-btn:hover {
            color: #86D200;
            transform: scale(1.08);
        }

        .wishlist-btn.active {
            color: #86D200;
        }

            .wishlist-btn.active i {
                font-weight: 900;
            }

    .product-info {
        padding: 10px 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .product-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #134856;
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 36px;
    }

    /* Price / Number - #FFAA0D */
    .product-price {
        font-size: 14px;
        font-weight: 700;
        color: #FFAA0D;
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 6px;
        flex-wrap: wrap;
    }

    .product-old-price {
        font-size: 12px;
        color: #6c8a93;
        text-decoration: line-through;
        font-weight: 400;
    }

    /* ================= NO PRODUCTS ================= */
    .no-products {
        grid-column: 1 / -1;
        text-align: center;
        padding: 70px 20px;
        color: #6c8a93;
        font-size: 15px;
        background: #fff;
        border-radius: 8px;
        border: 1px dashed #b0d4dc;
    }

        .no-products i {
            font-size: 42px;
            margin-bottom: 14px;
            display: block;
            color: #b0d4dc;
        }

        .no-products h5 {
            margin: 0 0 6px;
            font-weight: 600;
            color: #134856;
            font-size: 18px;
        }

        .no-products p {
            margin: 0;
            font-size: 14px;
            color: #6c8a93;
        }

    /* ================= TOAST ================= */
    .toast-msg {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: #134856;
        color: #fff;
        padding: 10px 22px;
        border-radius: 8px;
        font-size: 14px;
        z-index: 9999;
        opacity: 0;
        transition: opacity .25s;
        font-family: 'Poppins', sans-serif;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 1399.98px) {
        .product-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }
    }

    @@media (max-width: 1199.98px) {
        .product-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }
    }

    @@media (max-width: 991.98px) {
        .category-layout {
            flex-direction: column;
            gap: 18px;
        }

        .sidebar {
            flex: 1 1 auto;
            max-width: 100%;
            width: 100%;
        }

        .product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .category-page {
            padding: 10px 0 40px;
        }

        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .breadcrumb-area {
            font-size: 13px;
            margin-bottom: 14px;
        }
    }

    @@media (max-width: 480px) {
        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .product-title {
            font-size: 12.5px;
            min-height: 34px;
        }

        .product-price {
            font-size: 13px;
        }

        .product-info {
            padding: 8px 8px 10px;
        }

        .wishlist-btn {
            width: 32px;
            height: 32px;
            font-size: 14px;
        }
    }
</style>

<div class="container category-page">

    <!-- ================= BREADCRUMB ================= -->
    <div class="breadcrumb-area">
        <a href="/"><i class="fa-solid fa-house"></i> Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="#">Category</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>@ViewBag.CategoryName</span>
    </div>

    <div class="category-layout">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">

            <h4>Categories</h4>
            <ul class="category-list">
                <li><a asp-controller="Category" asp-action="Panjabi"        class="@(ViewBag.CategoryName == "Panjabi" ? "active" : "")">Panjabi</a></li>
                <li><a asp-controller="Category" asp-action="Thobe"          class="@(ViewBag.CategoryName == "Thobe" ? "active" : "")">Thobe</a></li>
                <li><a asp-controller="Category" asp-action="Shirt"          class="@(ViewBag.CategoryName == "Shirt" ? "active" : "")">Shirt</a></li>
                <li><a asp-controller="Category" asp-action="TShirt"         class="@(ViewBag.CategoryName == "T-Shirt" ? "active" : "")">T-Shirt</a></li>
                <li><a asp-controller="Category" asp-action="PoloShirt"      class="@(ViewBag.CategoryName == "Polo Shirt" ? "active" : "")">Polo Shirt</a></li>
                <li><a asp-controller="Category" asp-action="PantTrouser"    class="@(ViewBag.CategoryName == "Pant & Trouser" ? "active" : "")">Pant &amp; Trouser</a></li>
                <li><a asp-controller="Category" asp-action="WomensClothing" class="@(ViewBag.CategoryName == "Women's Clothing" ? "active" : "")">Women's Clothing</a></li>
                <li><a asp-controller="Category" asp-action="Attar"          class="@(ViewBag.CategoryName == "Attar" ? "active" : "")">Attar</a></li>
                <li><a asp-controller="Category" asp-action="Perfumes"       class="@(ViewBag.CategoryName == "Perfumes" ? "active" : "")">Perfumes</a></li>
                <li><a asp-controller="Category" asp-action="Gadgets"        class="@(ViewBag.CategoryName == "Gadgets" ? "active" : "")">Gadgets</a></li>
                <li><a asp-controller="Category" asp-action="Watch"          class="@(ViewBag.CategoryName == "Watch" ? "active" : "")">Watch</a></li>
                <li><a asp-controller="Category" asp-action="Wallet"         class="@(ViewBag.CategoryName == "Wallet" ? "active" : "")">Wallet</a></li>
                <li><a asp-controller="Category" asp-action="Sneakers"       class="@(ViewBag.CategoryName == "Sneakers" ? "active" : "")">Sneakers</a></li>
                <li><a asp-controller="Category" asp-action="Waistcoat"      class="@(ViewBag.CategoryName == "Waistcoat" ? "active" : "")">Waistcoat</a></li>
                <li><a asp-controller="Category" asp-action="Tupi"           class="@(ViewBag.CategoryName == "Tupi" ? "active" : "")">Tupi</a></li>
                <li><a asp-controller="Category" asp-action="ComboOffers"    class="@(ViewBag.CategoryName == "Combo Offers" ? "active" : "")">Combo Offers</a></li>
                <li><a asp-controller="Category" asp-action="Jubbah"         class="@(ViewBag.CategoryName == "Jubbah" ? "active" : "")">Jubbah</a></li>
                <li><a asp-controller="Category" asp-action="Katua"          class="@(ViewBag.CategoryName == "Katua" ? "active" : "")">Katua</a></li>
                <li><a asp-controller="Category" asp-action="FlashSale"      class="@(ViewBag.CategoryName == "Flash Sale" ? "active" : "")">Flash Sale</a></li>
            </ul>

            <!-- ================= NEW PRODUCTS ================= -->
            <div class="new-products-sidebar">
                <h4>New Products</h4>

                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/7xRkW8KV/1.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Waffle T-shirt - Tawaqkul</h5>
                        <span>395৳</span>
                    </div>
                </a>
                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/VYskZpVz/2.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Waffle T-shirt - Musafir</h5>
                        <span>395৳</span>
                    </div>
                </a>
                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/whjZxfNK/3.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Waffle T-shirt - Assalamu Alaikum</h5>
                        <span>395৳</span>
                    </div>
                </a>
                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/JwbWyD8G/4.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Waffle T-shirt - Muhammad my hero</h5>
                        <span>395৳</span>
                    </div>
                </a>
                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/gLKg35Sq/5.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Premium Cotton T-shirt - Khilafah &amp; Shariah</h5>
                        <span>550৳</span>
                    </div>
                </a>
                <a href="#" class="new-product-item">
                    <img src="https://i.ibb.co.com/RkNZH6Vh/6.jpg" alt="Product" loading="lazy" />
                    <div class="new-product-info">
                        <h5>Premium Cotton T-shirt - Greyish Blue</h5>
                        <span>550৳</span>
                    </div>
                </a>
            </div>
        </aside>

        <!-- ================= PRODUCT GRID ================= -->
        <div class="product-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                       class="product-card" data-product-id="@product.Id">
                        <div class="product-img-wrap">
                            @if (product.DiscountPercent.HasValue && product.DiscountPercent > 0)
                            {
                                <span class="discount-badge">@product.DiscountPercent%</span>
                            }
                            <button type="button" class="wishlist-btn" data-product-id="@product.Id" aria-label="Add to wishlist">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                        </div>
                        <div class="product-info">
                            <h3 class="product-title">@product.Name</h3>
                            <p class="product-price">
                                ৳@product.Price.ToString("0")
                                @if (product.OldPrice.HasValue && product.OldPrice > product.Price)
                                {
                                    <span class="product-old-price">৳@product.OldPrice.Value.ToString("0")</span>
                                }
                            </p>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="no-products">
                    <i class="fa-solid fa-box-open"></i>
                    <h5>No Products Found</h5>
                    <p>We couldn't find any products in this category.</p>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ==========================================
            // Wishlist toggle
            // ==========================================
            document.querySelectorAll('.wishlist-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var id = btn.getAttribute('data-product-id');
                    if (!id) return;

                    fetch('/Wishlist/Toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: parseInt(id) })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) return;

                        var icon = btn.querySelector('i');
                        if (data.added) {
                            btn.classList.add('active');
                            icon.classList.remove('fa-regular');
                            icon.classList.add('fa-solid');
                        } else {
                            btn.classList.remove('active');
                            icon.classList.remove('fa-solid');
                            icon.classList.add('fa-regular');
                        }

                        // হেডার badge আপডেট
                        var badge = document.getElementById('wishlistCountBadge');
                        if (badge) badge.textContent = data.count;
                        var badgeM = document.getElementById('wishlistCountBadgeMobile');
                        if (badgeM) badgeM.textContent = data.count;

                        showToast(data.message);
                    })
                    .catch(function (err) { console.error(err); });
                });
            });

            // ==========================================
            // পেজ লোডে Wishlist badge আপডেট
            // ==========================================
            fetch('/Wishlist/Count')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var badge = document.getElementById('wishlistCountBadge');
                    if (badge) badge.textContent = data.count;
                    var badgeM = document.getElementById('wishlistCountBadgeMobile');
                    if (badgeM) badgeM.textContent = data.count;
                })
                .catch(function () { /* ignore */ });

            // ==========================================
            // Toast notification
            // ==========================================
            function showToast(msg) {
                var t = document.createElement('div');
                t.className = 'toast-msg';
                t.textContent = msg;
                document.body.appendChild(t);
                requestAnimationFrame(function () { t.style.opacity = '1'; });
                setTimeout(function () {
                    t.style.opacity = '0';
                    setTimeout(function () { t.remove(); }, 300);
                }, 1600);
            }
        })();
    </script>
}