@{
    Layout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    /* ================= ACCOUNT PAGE ================= */
    .account-page {
        font-family: 'Poppins', 'Hind Siliguri', sans-serif;
        background: #f5f7fa;
        padding: 30px 0 60px;
        min-height: 70vh;
    }

    .account-wrap {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 28px;
        align-items: flex-start;
    }

    /* ================= SIDEBAR ================= */
    .account-sidebar {
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
        position: sticky;
        top: 20px;
    }

    .sidebar-user {
        padding: 24px 22px;
        background: linear-gradient(135deg, #134856 0%, #0a3a48 100%);
        color: #fff;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sidebar-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #86D200;
        flex: 0 0 auto;
        border: 2px solid rgba(134, 210, 0, .4);
    }

    .sidebar-user-info {
        min-width: 0;
        flex: 1;
    }

    .sidebar-user-info small {
        display: block;
        font-size: 12px;
        color: #b0d4dc;
        margin-bottom: 2px;
    }

    .sidebar-user-info strong {
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sidebar-menu {
        list-style: none;
        margin: 0;
        padding: 8px 0;
    }

    .sidebar-menu li {
        margin: 0;
    }

    .sidebar-menu li a,
    .sidebar-menu li button {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 15px 22px;
        background: transparent;
        border: 0;
        text-align: left;
        font-size: 15px;
        font-weight: 500;
        color: #134856;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s, color .2s, border-color .2s;
        font-family: inherit;
        border-left: 4px solid transparent;
    }

    .sidebar-menu li a i,
    .sidebar-menu li button i {
        width: 20px;
        text-align: center;
        font-size: 16px;
        color: #6c8a93;
        flex: 0 0 auto;
    }

    .sidebar-menu li a:hover,
    .sidebar-menu li button:hover {
        background: #f5f7fa;
        color: #028EA5;
    }

    .sidebar-menu li a:hover i,
    .sidebar-menu li button:hover i {
        color: #028EA5;
    }

    .sidebar-menu li a.active {
        background: #e8f8fb;
        color: #028EA5;
        border-left-color: #028EA5;
        font-weight: 600;
    }

    .sidebar-menu li a.active i {
        color: #028EA5;
    }

    .sidebar-menu li.logout-item {
        border-top: 1px solid #f0f0f0;
        margin-top: 8px;
        padding-top: 8px;
    }

    .sidebar-menu li.logout-item button {
        color: #c62828;
    }

    .sidebar-menu li.logout-item button i {
        color: #c62828;
    }

    .sidebar-menu li.logout-item button:hover {
        background: #fdeaea;
        color: #c62828;
    }

    .sidebar-menu li.logout-item button:hover i {
        color: #c62828;
    }

    /* ================= CONTENT ================= */
    .account-content {
        background: #fff;
        border-radius: 10px;
        padding: 34px 40px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
        min-height: 400px;
    }

    .content-title {
        font-size: 24px;
        font-weight: 700;
        color: #134856;
        margin: 0 0 6px;
    }

    .content-subtitle {
        font-size: 14px;
        color: #6c8a93;
        margin: 0 0 26px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    /* ================= ALERTS ================= */
    .alert-custom {
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
        animation: alertFadeIn .3s ease;
    }

    @@keyframes alertFadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-success {
        background: #e3f6ec;
        border: 1px solid #b3e2c6;
        color: #0f7b3e;
    }

    .alert-error {
        background: #fdeaea;
        border: 1px solid #f5c2c2;
        color: #b71c1c;
    }

    .alert-custom i {
        font-size: 16px;
    }

    /* ================= FORMS ================= */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-row.full {
        grid-template-columns: 1fr;
    }

    .form-group-account {
        margin-bottom: 0;
    }

    .form-group-account label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    .input-icon-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon-wrap > i {
        position: absolute;
        left: 16px;
        color: #6c8a93;
        font-size: 15px;
        pointer-events: none;
        z-index: 1;
    }

    .form-control-account {
        width: 100%;
        height: 52px;
        padding: 0 18px 0 44px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 15px;
        color: #134856;
        background: #fff;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        font-family: 'Poppins', 'Hind Siliguri', sans-serif;
    }

    .form-control-account:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }

    .form-control-account::placeholder {
        color: #a0b2b8;
    }

    .form-control-account:disabled {
        background: #f5f7fa;
        color: #6c8a93;
        cursor: not-allowed;
    }

    /* Password toggle button */
    .toggle-pwd {
        position: absolute;
        right: 12px;
        background: none;
        border: 0;
        color: #6c8a93;
        cursor: pointer;
        padding: 6px;
        display: flex;
        align-items: center;
        z-index: 2;
    }

    .toggle-pwd:hover {
        color: #134856;
    }

    /* Submit buttons */
    .btn-account {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 52px;
        padding: 0 32px;
        background: #134856;
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s, transform .1s;
        font-family: 'Poppins', 'Hind Siliguri', sans-serif;
        margin-top: 8px;
    }

    .btn-account:hover {
        background: #028EA5;
    }

    .btn-account:active {
        transform: scale(.98);
    }

    .btn-account:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    /* ================= EMPTY ORDERS ================= */
    .empty-orders {
        text-align: center;
        padding: 60px 20px;
        border: 1px dashed #d0d9e2;
        border-radius: 10px;
        background: #fafbfc;
    }

    .empty-orders i {
        font-size: 52px;
        color: #b0d4dc;
        margin-bottom: 16px;
        display: block;
    }

    .empty-orders h4 {
        font-size: 18px;
        color: #134856;
        margin: 0 0 8px;
    }

    .empty-orders p {
        font-size: 14px;
        color: #6c8a93;
        margin: 0 0 22px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    .empty-orders a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 46px;
        padding: 0 26px;
        background: #86D200;
        color: #134856;
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        transition: background .2s, color .2s;
    }

    .empty-orders a:hover {
        background: #134856;
        color: #fff;
    }

    /* ================= ORDER INFO BOX ================= */
    .order-info-box {
        margin-top: 32px;
        padding: 24px;
        background: #f8fbfc;
        border: 1px solid #e0edf1;
        border-radius: 10px;
    }

    .order-info-title {
        font-size: 15px !important;
        font-weight: 600;
        color: #134856;
        margin: 0 0 16px 0;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Poppins', 'Hind Siliguri', sans-serif;
        line-height: 1.4;
    }

    .order-info-title i {
        color: #028EA5;
        font-size: 16px;
        flex: 0 0 auto;
    }

    .order-info-list {
        list-style: none !important;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 12px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
        font-size: 14px;
        color: #134856;
        line-height: 1.6;
    }

    .order-info-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .order-info-list li > i {
        color: #86D200;
        width: 20px;
        min-width: 20px;
        text-align: center;
        font-size: 15px;
        flex: 0 0 20px;
        margin-top: 4px;
        line-height: 1;
    }

    .order-info-list li > span {
        flex: 1 1 auto;
        min-width: 0;
    }

    .order-info-list li strong {
        color: #134856;
        font-weight: 700;
    }

    /* ================= VALIDATION ================= */
    .field-validation-error {
        display: block;
        font-size: 12.5px;
        color: #c62828;
        margin-top: 6px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    input.input-validation-error {
        border-color: #e57373 !important;
        background: #fff5f5 !important;
    }

    /* ================= PASSWORD STRENGTH ================= */
    .pwd-strength {
        display: flex;
        gap: 4px;
        margin-top: 8px;
    }

    .pwd-strength .bar {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        background: #d5e5ea;
        transition: background .3s;
    }

    .pwd-strength.weak .bar:nth-child(1) {
        background: #e57373;
    }

    .pwd-strength.medium .bar:nth-child(1),
    .pwd-strength.medium .bar:nth-child(2) {
        background: #ffb74d;
    }

    .pwd-strength.strong .bar {
        background: #66bb6a;
    }

    .pwd-hint {
        font-size: 11.5px;
        color: #6c8a93;
        margin-top: 5px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    /* ================= SECURITY TIPS ================= */
    .security-tips-box {
        margin-top: 24px;
        padding: 18px 22px;
        background: #f8fbfc;
        border: 1px solid #e0edf1;
        border-left: 4px solid #028EA5;
        border-radius: 10px;
    }

    .security-tips-title {
        font-size: 14px;
        font-weight: 600;
        color: #134856;
        margin: 0 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Poppins', 'Hind Siliguri', sans-serif;
    }

    .security-tips-title i {
        color: #028EA5;
    }

    .security-tips-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 8px;
        font-size: 13.5px;
        color: #3f7384;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    .security-tips-list li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .security-tips-list li i {
        color: #86D200;
        font-size: 12px;
        margin-top: 5px;
        flex: 0 0 auto;
    }

    /* ================= ACCOUNT INFO GRID ================= */
    .account-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px 28px;
        font-size: 14px;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 991.98px) {
        .account-page {
            padding: 20px 0 40px;
        }

        .account-wrap {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .account-sidebar {
            position: static;
        }

        .account-content {
            padding: 24px 22px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }

    @@media (max-width: 767.98px) {
        .account-info-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 575.98px) {
        .account-page {
            padding: 16px 0 40px;
        }

        .sidebar-user {
            padding: 20px 18px;
        }

        .sidebar-avatar {
            width: 48px;
            height: 48px;
            font-size: 20px;
        }

        .sidebar-menu li a,
        .sidebar-menu li button {
            padding: 14px 18px;
            font-size: 14.5px;
        }

        .account-content {
            padding: 22px 18px;
            border-radius: 10px;
        }

        .content-title {
            font-size: 20px;
        }

        .content-subtitle {
            font-size: 13px;
            margin-bottom: 20px;
        }

        .form-control-account {
            height: 48px;
            font-size: 14.5px;
            padding-left: 40px;
        }

        .input-icon-wrap > i {
            left: 14px;
            font-size: 14px;
        }

        .btn-account {
            width: 100%;
            height: 48px;
            padding: 0 20px;
        }

        .empty-orders {
            padding: 40px 16px;
        }

        .empty-orders i {
            font-size: 42px;
        }

        .empty-orders h4 {
            font-size: 16px;
        }

        .empty-orders p {
            font-size: 13px;
        }

        .order-info-box {
            margin-top: 24px;
            padding: 18px 16px;
        }

        .order-info-title {
            font-size: 14px !important;
            margin-bottom: 14px;
        }

        .order-info-list {
            font-size: 13px;
            gap: 10px;
        }

        .order-info-list li > i {
            font-size: 14px;
            width: 18px;
            min-width: 18px;
            flex: 0 0 18px;
        }

        .security-tips-box {
            padding: 14px 16px;
        }

        .security-tips-list {
            font-size: 12.5px;
        }
    }
</style>

<div class="container account-page">
    <div class="account-wrap">

        <!-- ================= SIDEBAR ================= -->
        <aside class="account-sidebar">

            <div class="sidebar-user">
                <div class="sidebar-avatar">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="sidebar-user-info">
                    <small>স্বাগতম</small>
                    <strong>@(User.Identity?.Name ?? "User")</strong>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Account" asp-action="Profile"
                       class="@(ViewData["ActiveTab"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="fa-solid fa-user-pen"></i>
                        <span>Profile</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Account" asp-action="Orders"
                       class="@(ViewData["ActiveTab"]?.ToString() == "Orders" ? "active" : "")">
                        <i class="fa-solid fa-clipboard-list"></i>
                        <span>My Orders</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Account" asp-action="ChangePassword"
                       class="@(ViewData["ActiveTab"]?.ToString() == "ChangePassword" ? "active" : "")">
                        <i class="fa-solid fa-lock"></i>
                        <span>Change Password</span>
                    </a>
                </li>
                <li class="logout-item">
                    <form asp-controller="Account" asp-action="SignOut" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </li>
            </ul>
        </aside>

        <!-- ================= CONTENT ================= -->
        <section class="account-content">

            @* ================= SUCCESS MESSAGE ================= *@
            @if (TempData["Success"] != null)
            {
                <div class="alert-custom alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @* ================= ERROR MESSAGE ================= *@
            @if (TempData["Error"] != null)
            {
                <div class="alert-custom alert-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @* ================= PAGE CONTENT ================= *@
            @RenderBody()
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
}