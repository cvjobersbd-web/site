@{
    ViewData["Title"] = "My Orders";
    ViewData["ActiveTab"] = "Orders";
    Layout = "_AccountLayout";
}

<h2 class="content-title">My Orders</h2>
<p class="content-subtitle">আপনার সব অর্ডার এখানে দেখুন এবং ট্র্যাক করুন</p>

@* ================= EMPTY STATE ================= *@
<div class="empty-orders">
    <i class="fa-solid fa-box-open"></i>
    <h4>You don't have any orders yet</h4>
    <p>আপনার অর্ডার এখনো নেই। কেনাকাটা শুরু করুন এবং আপনার অর্ডার এখানে দেখুন!</p>
    <a asp-controller="Home" asp-action="Index" class="start-shopping-btn">
        <i class="fa-solid fa-bag-shopping"></i>
        <span>Start Shopping</span>
    </a>
</div>

<style>
    /* Fix: বড় বক্স আইকনের স্টাইল যেন বাটনের ভেতরের ব্যাগ আইকনে প্রয়োগ না হয় */
    .empty-orders a.start-shopping-btn {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .empty-orders a.start-shopping-btn i {
        display: inline-block !important;
        font-size: 18px !important;
        line-height: 1 !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        background: none !important;
        border-radius: 0 !important;
        color: inherit !important;
        opacity: 1 !important;
    }

    .empty-orders a.start-shopping-btn span {
        line-height: 1;
    }
</style>
