@model al_ibtisam.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActiveTab"] = "ChangePassword";
    Layout = "_AccountLayout";
}

<h2 class="content-title">Change Password</h2>
<p class="content-subtitle">নিরাপত্তার জন্য একটি শক্তিশালী পাসওয়ার্ড ব্যবহার করুন</p>

@* ================= GLOBAL ERROR MESSAGE ================= *@
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert-custom alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                @error.ErrorMessage
            }
        </span>
    </div>
}

<form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate id="changePwdForm">
    @Html.AntiForgeryToken()

    @* ================= OLD PASSWORD ================= *@
    <div class="form-row full">
        <div class="form-group-account">
            <label asp-for="OldPassword">Old Password</label>
            <div class="input-icon-wrap">
                <i class="fa-solid fa-lock"></i>
                <input asp-for="OldPassword"
                       type="password"
                       id="oldPwd"
                       class="form-control-account"
                       placeholder="Enter your current password"
                       autocomplete="current-password" />
                <button type="button" class="toggle-pwd" data-target="oldPwd" aria-label="Show password">
                    <i class="fa-regular fa-eye-slash"></i>
                </button>
            </div>
            <span asp-validation-for="OldPassword" class="field-validation-error"></span>
        </div>
    </div>

    @* ================= NEW + CONFIRM PASSWORD ================= *@
    <div class="form-row">

        <!-- New Password -->
        <div class="form-group-account">
            <label asp-for="NewPassword">New Password</label>
            <div class="input-icon-wrap">
                <i class="fa-solid fa-lock"></i>
                <input asp-for="NewPassword"
                       type="password"
                       id="newPwd"
                       class="form-control-account"
                       placeholder="Enter new password"
                       autocomplete="new-password" />
                <button type="button" class="toggle-pwd" data-target="newPwd" aria-label="Show password">
                    <i class="fa-regular fa-eye-slash"></i>
                </button>
            </div>

            @* Password Strength Indicator *@
            <div class="pwd-strength" id="pwdStrength">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
            <div class="pwd-hint" id="pwdHint">কমপক্ষে ৬ অক্ষর ব্যবহার করুন</div>

            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>

        <!-- Confirm Password -->
        <div class="form-group-account">
            <label asp-for="ConfirmPassword">Confirm Password</label>
            <div class="input-icon-wrap">
                <i class="fa-solid fa-lock"></i>
                <input asp-for="ConfirmPassword"
                       type="password"
                       id="conPwd"
                       class="form-control-account"
                       placeholder="Confirm new password"
                       autocomplete="new-password" />
                <button type="button" class="toggle-pwd" data-target="conPwd" aria-label="Show password">
                    <i class="fa-regular fa-eye-slash"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
    </div>

    @* ================= SECURITY TIPS ================= *@
    <div class="security-tips-box">
        <h3 class="security-tips-title">
            <i class="fa-solid fa-shield-halved"></i>
            Password Security Tips
        </h3>
        <ul class="security-tips-list">
            <li>
                <i class="fa-solid fa-check"></i>
                <span>কমপক্ষে ৬ অক্ষরের পাসওয়ার্ড ব্যবহার করুন</span>
            </li>
            <li>
                <i class="fa-solid fa-check"></i>
                <span>বড় ও ছোট হাতের অক্ষর মিশ্রণ করুন</span>
            </li>
            <li>
                <i class="fa-solid fa-check"></i>
                <span>কমপক্ষে একটি সংখ্যা ও একটি বিশেষ চিহ্ন (@@, #, $, ইত্যাদি) যোগ করুন</span>
            </li>
            <li>
                <i class="fa-solid fa-check"></i>
                <span>সহজে অনুমান করা যায় এমন পাসওয়ার্ড ব্যবহার করবেন না</span>
            </li>
            <li>
                <i class="fa-solid fa-check"></i>
                <span>অন্য কোনো সাইটের পাসওয়ার্ড পুনরায় ব্যবহার করবেন না</span>
            </li>
        </ul>
    </div>

    @* ================= SUBMIT ================= *@
    <button type="submit" class="btn-account" id="updatePwdBtn">
        <i class="fa-solid fa-key"></i>
        Update Password
    </button>
</form>

@section Scripts {
    <script>
        (function () {

            // ==========================================
            // Password Show/Hide Toggle
            // ==========================================
            document.querySelectorAll('.toggle-pwd').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-target'));
                    var icon = btn.querySelector('i');
                    if (!input || !icon) return;

                    var isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                    btn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                });
            });

            // ==========================================
            // Password Strength Indicator
            // ==========================================
            var newPwd = document.getElementById('newPwd');
            var pwdStrength = document.getElementById('pwdStrength');
            var pwdHint = document.getElementById('pwdHint');

            function checkStrength(password) {
                var strength = 0;
                if (password.length >= 6) strength++;
                if (password.length >= 10) strength++;
                if (/[A-Z]/.test(password) && /[a-z]/.test(password)) strength++;
                if (/\d/.test(password)) strength++;
                if (/[^A-Za-z0-9]/.test(password)) strength++;

                pwdStrength.classList.remove('weak', 'medium', 'strong');

                if (password.length === 0) {
                    pwdHint.textContent = 'কমপক্ষে ৬ অক্ষর ব্যবহার করুন';
                    pwdHint.style.color = '#6c8a93';
                } else if (strength <= 2) {
                    pwdStrength.classList.add('weak');
                    pwdHint.textContent = 'দুর্বল পাসওয়ার্ড';
                    pwdHint.style.color = '#c62828';
                } else if (strength <= 3) {
                    pwdStrength.classList.add('medium');
                    pwdHint.textContent = 'মাঝারি পাসওয়ার্ড';
                    pwdHint.style.color = '#e65100';
                } else {
                    pwdStrength.classList.add('strong');
                    pwdHint.textContent = 'শক্তিশালী পাসওয়ার্ড ✓';
                    pwdHint.style.color = '#2e7d32';
                }
            }

            if (newPwd) {
                newPwd.addEventListener('input', function () {
                    checkStrength(newPwd.value);
                });
            }

            // ==========================================
            // Confirm Password Live Check
            // ==========================================
            var conPwd = document.getElementById('conPwd');
            if (conPwd && newPwd) {
                conPwd.addEventListener('input', function () {
                    if (conPwd.value && conPwd.value !== newPwd.value) {
                        conPwd.setCustomValidity('Passwords do not match');
                    } else {
                        conPwd.setCustomValidity('');
                    }
                });
            }

            // ==========================================
            // Submit Button Loading State
            // ==========================================
            var form = document.getElementById('changePwdForm');
            var btn = document.getElementById('updatePwdBtn');

            if (form && btn) {
                form.addEventListener('submit', function (e) {
                    var oldVal = document.getElementById('oldPwd').value.trim();
                    var newVal = document.getElementById('newPwd').value.trim();
                    var conVal = document.getElementById('conPwd').value.trim();

                    if (!oldVal) {
                        e.preventDefault();
                        alert('পুরনো পাসওয়ার্ড দিন');
                        return;
                    }

                    if (newVal.length < 6) {
                        e.preventDefault();
                        alert('নতুন পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে');
                        return;
                    }

                    if (newVal !== conVal) {
                        e.preventDefault();
                        alert('দুইটি পাসওয়ার্ড মিলছে না');
                        return;
                    }

                    if (newVal === oldVal) {
                        e.preventDefault();
                        alert('নতুন পাসওয়ার্ড পুরনো পাসওয়ার্ড থেকে আলাদা হতে হবে');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';
                });
            }

            // ==========================================
            // Auto-focus first input with error
            // ==========================================
            var firstError = document.querySelector('.input-validation-error');
            if (firstError) {
                firstError.focus();
            }
        })();
    </script>
}