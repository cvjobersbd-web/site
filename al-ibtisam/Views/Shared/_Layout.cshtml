@using al_ibtisam.Data
@using al_ibtisam.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext _db
@inject ISiteSettingService _siteSettings

@{
    // ============================================================
    // Navbar-এ দেখানোর জন্য ক্যাটাগরি (শুধু ShowInNavbar = true)
    // ============================================================
    var navbarCategories = _db.Categories
        .Where(c => c.ShowInNavbar)
        .OrderBy(c => c.DisplayOrder)
        .ThenBy(c => c.Id)
        .ToList();

    // Navbar-এ দেখানোর ডিসপ্লে নাম
    Func<string, string> toDisplay = (name) =>
    {
        if (name == "Flash Sale") return "FLASH SALE - 26 🔥🔥";
        if (name == "T-Shirt") return "Drop Shoulder";
        return name;
    };

    // ============================================================
    // 🆕 ডাটাবেজ থেকে ডাইনামিক থিম কালার লোড করা হচ্ছে
    // ============================================================
    var themeColors = await _siteSettings.GetThemeColorsAsync();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - al_ibtisam</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/al_ibtisam.styles.css" asp-append-version="true" />
    
    <style>
        /* ============================================================
           🆕 ডাইনামিক CSS ভ্যারিয়েবল
           অ্যাডমিন প্যানেল থেকে কালার চেঞ্জ করলে পুরো সাইটে আপডেট হবে
           ============================================================ */
        :root {
            --theme-primary: @themeColors["Primary"];
            --theme-secondary: @themeColors["Secondary"];
            --theme-button: @themeColors["Button"];
            --theme-price: @themeColors["Price"];
            --theme-bg: @themeColors["Bg"];
        }

        html, body { margin: 0 !important; padding: 0 !important; background-color: var(--theme-bg); }
        body { overflow-x: hidden; }
        body > header { display: block; margin: 0 !important; padding: 0 !important; border: 0 !important; min-height: 0 !important; height: auto !important; }

        .site-container { width: 100%; max-width: 1626px; margin: 0 auto; padding: 0 15px; }
        .desktop-header .site-container { padding: 0; }
        @@media (max-width: 1655.98px) { .desktop-header .site-container { padding: 0 15px; } }
        .desktop-header { display: block; margin: 0; padding: 0; }

        /* ---------- Main header ---------- */
        .main-header { background: var(--theme-primary); border-bottom: 1px solid rgba(0,0,0,0.1); height: 112px; }
        .main-header-inner { height: 100%; display: flex; align-items: center; gap: 0; }
        .brand-logo img { height: 74px; width: auto; max-width: 270px; object-fit: contain; display: block; }
        .brand-logo { flex: 0 0 280px; }

        .search-box { flex: 1 1 auto; width: 100%; max-width: 933px; min-width: 0; height: 62px; display: flex; border: 2px solid var(--theme-secondary); border-radius: 4px; overflow: hidden; background: #fff; }
        .search-box input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 0 32px; font-size: 17px; color: var(--theme-primary); background: transparent; }
        .search-box input::placeholder { color: #6c8a93; }
        .search-box button { flex: 0 0 77px; border: 0; background: var(--theme-secondary); color: #fff; font-size: 24px; cursor: pointer; transition: background .2s; }
        .search-box button:hover { background: var(--theme-button); color: var(--theme-primary); }

        .header-actions { flex: 0 0 auto; margin-left: auto; padding-left: 48px; display: flex; align-items: center; gap: 32px; padding-right: 0; }
        .account-link { flex: 0 0 auto; display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--theme-bg); position: relative; }
        .account-icon { width: 54px; height: 54px; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--theme-bg); flex: 0 0 auto; }
        .account-text { white-space: nowrap; line-height: 1.25; }
        .account-text small { display: block; font-size: 15px; color: rgba(255,255,255,0.7); }
        .account-text strong { font-size: 18px; font-weight: 500; color: var(--theme-bg); display: block; max-width: 130px; overflow: hidden; text-overflow: ellipsis; }

        /* ---------- Account Dropdown ---------- */
        .account-dropdown { position: relative; }
        .account-menu {
            position: absolute; top: calc(100% + 12px); right: 0; min-width: 220px;
            background: #fff; border-radius: 10px; box-shadow: 0 10px 30px rgba(15, 76, 92, .18);
            padding: 8px; z-index: 999; opacity: 0; visibility: hidden;
            transform: translateY(-8px); transition: opacity .2s, visibility .2s, transform .2s;
        }
        .account-dropdown.open .account-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .account-menu::before {
            content: ""; position: absolute; top: -6px; right: 30px; width: 12px; height: 12px;
            background: #fff; transform: rotate(45deg); box-shadow: -2px -2px 4px rgba(0,0,0,.03);
        }
        .account-menu a, .account-menu button {
            display: flex; align-items: center; gap: 12px; width: 100%; padding: 11px 14px;
            border: 0; background: transparent; text-align: left; font-size: 14px; font-weight: 500;
            color: var(--theme-primary); text-decoration: none; border-radius: 6px; cursor: pointer;
            transition: background .15s, color .15s; font-family: inherit;
        }
        .account-menu a i, .account-menu button i { width: 18px; text-align: center; font-size: 15px; color: var(--theme-secondary); }
        .account-menu a:hover, .account-menu button:hover { background: var(--theme-bg); color: var(--theme-secondary); }
        .account-menu button.logout-btn {
            color: #c62828; border-top: 1px solid #E5FBFF; border-radius: 0 0 6px 6px;
            margin-top: 4px; padding-top: 13px;
        }
        .account-menu button.logout-btn i { color: #c62828; }
        .account-menu button.logout-btn:hover { background: #fdeaea; color: #c62828; }

        .wishlist-link { position: relative; color: var(--theme-bg); display: inline-flex; margin-right: 13px; text-decoration: none; }
        .wishlist-link:hover { color: var(--theme-button); }
        .wishlist-badge { position: absolute; top: -14px; right: -16px; min-width: 25px; height: 25px; border-radius: 50%; background: var(--theme-button); color: var(--theme-primary); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid var(--theme-primary); }

        .cart-link { position: relative; color: var(--theme-bg); display: inline-flex; margin-right: 13px; text-decoration: none; cursor: pointer; }
        .cart-link:hover { color: var(--theme-button); }
        .cart-badge { position: absolute; top: -14px; right: -16px; min-width: 25px; height: 25px; border-radius: 50%; background: var(--theme-button); color: var(--theme-primary); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid var(--theme-primary); }

        /* ---------- Category nav ---------- */
        .category-nav { padding: 0; background: var(--theme-primary); border-bottom: 1px solid rgba(0,0,0,0.1); box-shadow: 0 2px 3px rgba(0,0,0,.06); position: relative; }
        .category-nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 61px; }
        .category-nav .navbar-nav { flex-direction: row; flex-wrap: wrap; max-width: 1400px; padding-left: 0; margin: 0; list-style: none; }
        .category-nav .nav-link { display: flex; align-items: center; gap: 7px; padding: 0 12px; height: 61px; font-size: 17px; font-weight: 500; letter-spacing: .1px; color: var(--theme-bg); white-space: nowrap; }
        .category-nav .nav-link:hover { color: var(--theme-button); }
        .category-nav .flash-sale { font-weight: 600; color: var(--theme-button); }

        .hotline { display: flex; align-items: center; gap: 10px; padding-right: 0; }
        .hotline svg { width: 28px; height: 28px; flex: 0 0 auto; stroke: var(--theme-button); }
        .hotline small { display: block; font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.2; }
        .hotline strong { font-size: 18px; font-weight: 500; color: var(--theme-bg); line-height: 1.2; }

        /* ---------- Mobile header ---------- */
        .mobile-header { display: none; background: var(--theme-primary); border-bottom: 1px solid rgba(0,0,0,0.1); padding: 10px 15px; }
        .mobile-header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .mobile-header .search-icon,
        .mobile-header .account-icon-m,
        .mobile-header .cart-icon-m,
        .mobile-header .wishlist-icon-m { background: none; border: 0; padding: 6px; font-size: 22px; color: var(--theme-bg); cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative; text-decoration: none; }
        .mobile-header .cart-icon-m:hover,
        .mobile-header .wishlist-icon-m:hover { color: var(--theme-button); }
        .mobile-header .cart-badge-m,
        .mobile-header .wishlist-badge-m { position: absolute; top: -2px; right: -6px; min-width: 18px; height: 18px; border-radius: 50%; background: var(--theme-button); color: var(--theme-primary); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid var(--theme-primary); }
        .mobile-header .mobile-logo { flex: 1; display: flex; justify-content: center; }
        .mobile-header .mobile-logo img { height: 42px; width: auto; object-fit: contain; }
        .mobile-header-inner { position: relative; min-height: 44px; }
        .mobile-header .mobile-logo { position: absolute; left: 50%; transform: translateX(-50%); flex: none; }
        .mobile-header .account-icon-m { margin-left: auto; }

        .mobile-cat-strip { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.1); }
        .mobile-cat-list { flex: 1; min-width: 0; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
        .mobile-cat-list::-webkit-scrollbar { display: none; }
        .mobile-cat-list a { flex: 0 0 auto; padding: 8px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 999px; background: transparent; color: var(--theme-bg); font-size: 13px; font-weight: 500; text-decoration: none; white-space: nowrap; }
        .mobile-cat-more { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 0; border-radius: 999px; background: var(--theme-button); color: var(--theme-primary); font-size: 13px; font-weight: 700; cursor: pointer; }

        .mobile-search-bar { display: none; padding: 10px 15px; background: var(--theme-primary); border-bottom: 1px solid rgba(0,0,0,0.1); }
        .mobile-search-bar.open { display: block; }
        .mobile-search-bar form { display: flex; height: 52px; border: 2px solid var(--theme-secondary); border-radius: 4px; overflow: hidden; background: #fff; }
        .mobile-search-bar input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 0 16px; font-size: 16px; color: var(--theme-primary); background: transparent; }
        .mobile-search-bar button { flex: 0 0 64px; border: 0; background: var(--theme-secondary); color: #fff; font-size: 20px; cursor: pointer; }

        /* ---------- Mobile drawer ---------- */
        .mobile-drawer { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #fff; z-index: 1050; transform: translateX(-100%); transition: transform .3s ease; display: flex; flex-direction: column; }
        .mobile-drawer.open { transform: translateX(0); }
        .mobile-drawer-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid rgba(255,255,255,0.1); background: var(--theme-primary); }
        .mobile-drawer-header .drawer-logo img { height: 38px; width: auto; object-fit: contain; }
        .mobile-drawer-header .drawer-close { background: rgba(255,255,255,0.1); border: 0; width: 36px; height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--theme-bg); cursor: pointer; }
        .mobile-drawer-body { flex: 1; overflow-y: auto; padding: 8px 0; }
        .mobile-drawer-body ul { list-style: none; margin: 0; padding: 0; }
        .mobile-drawer-body ul li { border-bottom: 1px solid #E5FBFF; }
        .mobile-drawer-body ul li a { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; font-size: 17px; font-weight: 500; color: var(--theme-primary); text-decoration: none; }
        .mobile-drawer-body ul li a:hover { background: #E5FBFF; }
        .mobile-drawer-body ul li a i { font-size: 13px; color: var(--theme-button); }
        .mobile-drawer-body ul li a.flash { color: var(--theme-button); font-weight: 600; }
        .mobile-drawer-footer { display: flex; gap: 12px; padding: 16px 18px; border-top: 1px solid #E5FBFF; background: #fff; }
        .mobile-drawer-footer a { flex: 1; display: flex; align-items: center; justify-content: center; height: 48px; border-radius: 6px; background: var(--theme-button); color: var(--theme-primary); font-size: 14px; font-weight: 700; text-decoration: none; transition: background .2s, color .2s; }
        .mobile-drawer-footer a:hover { background: var(--theme-primary); color: var(--theme-bg); }
        .mobile-drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1040; opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility .3s ease; }
        .mobile-drawer-overlay.show { opacity: 1; visibility: visible; }

        /* ---------- Cart drawer ---------- */
        .cart-drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 1090; opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility .3s ease; }
        .cart-drawer-overlay.show { opacity: 1; visibility: visible; }
        .cart-drawer { position: fixed; top: 0; right: 0; width: 420px; max-width: 100%; height: 100%; background: #fff; z-index: 1100; transform: translateX(100%); transition: transform .3s ease; display: flex; flex-direction: column; box-shadow: -4px 0 24px rgba(0,0,0,.12); font-family: 'Poppins', 'League Spartan', sans-serif; }
        .cart-drawer.open { transform: translateX(0); }
        .cart-drawer-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid #E5FBFF; flex: 0 0 auto; }
        .cart-drawer-header h3 { font-size: 20px; font-weight: 700; color: var(--theme-primary); margin: 0; }
        .cart-drawer-close { background: transparent; border: 0; font-size: 22px; color: var(--theme-primary); cursor: pointer; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: background .2s, color .2s; }
        .cart-drawer-close:hover { background: #E5FBFF; color: var(--theme-button); }
        .cart-drawer-body { flex: 1 1 auto; overflow-y: auto; padding: 20px 24px; }
        .cart-empty { text-align: center; padding: 60px 10px; color: #6c8a93; }
        .cart-empty i { font-size: 48px; color: #b0d4dc; margin-bottom: 14px; display: block; }
        .cart-empty p { margin: 0; font-size: 15px; }
        .cart-item { display: flex; gap: 14px; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid #E5FBFF; position: relative; }
        .cart-item:last-child { border-bottom: 0; margin-bottom: 0; }
        .cart-item-img { flex: 0 0 70px; width: 70px; height: 88px; border-radius: 6px; overflow: hidden; background: #f3f3f3; }
        .cart-item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cart-item-info { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; padding-right: 20px; }
        .cart-item-name { font-size: 14px; font-weight: 600; color: var(--theme-primary); margin: 0; line-height: 1.35; }
        .cart-item-size { font-size: 13px; color: #6c8a93; }
        .cart-item-price-row { font-size: 13.5px; color: var(--theme-primary); margin-top: 4px; }
        .cart-item-original { color: #6c8a93; font-size: 12.5px; }
        .cart-item-price { color: var(--theme-price); font-weight: 700; font-size: 14px; }
        .cart-item-qty { color: #6c8a93; font-size: 12.5px; }
        .cart-item-remove { position: absolute; top: 0; right: 0; background: transparent; border: 0; color: #6c8a93; font-size: 16px; cursor: pointer; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: color .2s, background .2s; }
        .cart-item-remove:hover { color: var(--theme-button); background: #F2FCDE; }
        .cart-drawer-footer { flex: 0 0 auto; padding: 20px 24px 24px; border-top: 1px solid #E5FBFF; background: #fff; }
        .cart-subtotal { display: flex; align-items: center; justify-content: space-between; font-size: 16px; margin-bottom: 16px; color: var(--theme-primary); }
        .cart-subtotal strong { font-size: 18px; font-weight: 700; color: var(--theme-price); }
        .cart-checkout-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 54px; background: var(--theme-button); color: var(--theme-primary); border-radius: 6px; text-decoration: none; font-size: 15px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; transition: background .2s, color .2s; font-family: 'Poppins', sans-serif; }
        .cart-checkout-btn:hover { background: var(--theme-primary); color: var(--theme-bg); }

        /* ---------- Responsive ---------- */
        @@media (min-width: 992px) {
            .mobile-header, .mobile-search-bar, .mobile-drawer, .mobile-drawer-overlay { display: none !important; }
        }
        @@media (max-width: 1399.98px) {
            .search-box { flex: 1 1 auto; }
            .header-actions { gap: 22px; }
            .category-nav .nav-link { font-size: 16px; padding: 0 10px; }
        }
        @@media (max-width: 991.98px) {
            .main-header, .category-nav { display: none !important; }
            .mobile-header { display: block; }
            .footer-main { grid-template-columns: 1fr 1fr; gap: 36px 24px; padding: 40px 0 28px; }
            .footer-brand { grid-column: 1 / -1; }
        }
        @@media (max-width: 480px) {
            .cart-drawer { width: 100%; }
        }

        /* ---------- Footer ---------- */
        body { margin-bottom: 0 !important; }
        .site-footer { background: var(--theme-primary); color: rgba(255,255,255,0.7); font-size: 15px; margin-top: 20px; }
        .site-footer a { color: rgba(255,255,255,0.7); text-decoration: none; transition: color .2s; }
        .site-footer a:hover { color: var(--theme-button); }
        .footer-main { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: 48px; padding: 56px 0 44px; }
        .footer-logo { display: inline-block; padding: 10px 16px; background: #fff; border-radius: 8px; }
        .footer-logo img { height: 56px; width: auto; max-width: 240px; object-fit: contain; display: block; }
        .footer-about { margin: 18px 0 20px; max-width: 360px; line-height: 1.7; }
        .footer-contact { list-style: none; margin: 0 0 22px; padding: 0; }
        .footer-contact li { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
        .footer-contact i { width: 18px; text-align: center; color: var(--theme-button); }
        .footer-contact strong { color: #fff; font-weight: 600; }
        .footer-social { display: flex; gap: 10px; }
        .footer-social a { width: 40px; height: 40px; border: 1px solid rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; color: var(--theme-bg); transition: background .2s, border-color .2s, color .2s; }
        .footer-social a:hover { background: var(--theme-button); border-color: var(--theme-button); color: var(--theme-primary); }
        .footer-col h4 { margin: 0 0 20px; font-size: 16px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; color: #fff; }
        .footer-col ul { list-style: none; margin: 0; padding: 0; }
        .footer-col li { margin-bottom: 12px; }
        .footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); }
        .footer-bottom-inner { display: flex; align-items: center; justify-content: center; padding: 22px 0; }
        .footer-copy { color: rgba(255,255,255,0.5); font-size: 14px; text-align: center; }
    </style>
</head>
<body>
    <header>
        <!-- ================= DESKTOP HEADER ================= -->
        <div class="desktop-header">
            <div class="main-header">
                <div class="site-container main-header-inner">
                    <a class="brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="https://i.ibb.co.com/DfjPHZtK/al-ibtisam-logo.webp" alt="al_ibtisam" />
                    </a>

                    <form class="search-box" role="search" method="get" action="#">
                        <input type="text" name="q" placeholder="Search for Products..." aria-label="Search" />
                        <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </form>

                    <div class="header-actions">

                        @* === লগইন থাকলে Account Dropdown === *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="account-dropdown" id="accountDropdown">
                                <a href="javascript:void(0)" class="account-link" id="accountToggle">
                                    <span class="account-icon"><i class="fa-regular fa-user"></i></span>
                                    <span class="account-text">
                                        <small>স্বাগতম</small>
                                        <strong>@(User.Identity.Name ?? "User")</strong>
                                    </span>
                                </a>

                                <div class="account-menu" id="accountMenu">
                                    <a asp-controller="Account" asp-action="Profile">
                                        <i class="fa-regular fa-user"></i> My Profile
                                    </a>
                                    <a asp-controller="Account" asp-action="Orders">
                                        <i class="fa-solid fa-bag-shopping"></i> My Orders
                                    </a>
                                    <a asp-controller="Wishlist" asp-action="Wishlist">
                                        <i class="fa-regular fa-heart"></i> My Wishlist
                                    </a>
                                    <a href="#">
                                        <i class="fa-solid fa-location-dot"></i> My Address
                                    </a>
                                    <form asp-controller="Account" asp-action="SignOut" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="logout-btn">
                                            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="SignIn" class="account-link">
                                <span class="account-icon"><i class="fa-regular fa-user"></i></span>
                                <span class="account-text">
                                    <small>Sign In</small>
                                    <strong>Your Account</strong>
                                </span>
                            </a>
                        }

                        <a asp-controller="Wishlist" asp-action="Wishlist" class="wishlist-link" aria-label="Wishlist">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                            <span class="wishlist-badge" id="wishlistCountBadge">0</span>
                        </a>

                        <a href="javascript:void(0)" class="cart-link" id="cartLink" aria-label="Cart">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 8h14l1 12H4L5 8z" />
                                <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
                            </svg>
                            <span class="cart-badge" id="cartCountBadge">0</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- ================= DYNAMIC NAVBAR ================= -->
            <nav class="navbar navbar-expand-lg category-nav">
                <div class="site-container">
                    <button class="navbar-toggler my-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse category-nav-inner" id="mainNav">
                        <ul class="navbar-nav">
                            @foreach (var cat in navbarCategories)
                            {
                                var displayName = toDisplay(cat.Name);

                                <li class="nav-item">
                                    <a class="nav-link @(cat.IsFlashSale ? "flash-sale" : "")"
                                       asp-controller="Category"
                                       asp-action="Load"
                                       asp-route-name="@cat.Name">@displayName</a>
                                </li>
                            }
                        </ul>
                        <div class="hotline">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2a9 9 0 0 1 9 9" /><path d="M13 6a5 5 0 0 1 5 5" /><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                            <div>
                                <small>Hotline:</small>
                                <strong>09638090000</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <!-- ================= MOBILE HEADER ================= -->
        <div class="mobile-header">
            <div class="mobile-header-inner">
                <button class="search-icon" id="mobileSearchToggle" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <a href="/" class="mobile-logo">
                    <img src="https://i.ibb.co.com/DfjPHZtK/al-ibtisam-logo.webp" alt="al_ibtisam" />
                </a>
                <a asp-controller="Wishlist" asp-action="Wishlist" class="wishlist-icon-m" aria-label="Wishlist">
                    <i class="fa-regular fa-heart"></i>
                    <span class="wishlist-badge-m" id="wishlistCountBadgeMobile">0</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Profile" class="account-icon-m" aria-label="Account">
                        <i class="fa-solid fa-user"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="SignIn" class="account-icon-m" aria-label="Account">
                        <i class="fa-regular fa-user"></i>
                    </a>
                }

                <a href="javascript:void(0)" class="cart-icon-m" id="cartLinkMobile" aria-label="Cart">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="cart-badge-m" id="cartCountBadgeMobile">0</span>
                </a>
            </div>
            <div class="mobile-cat-strip">
                <div class="mobile-cat-list">
                    @foreach (var cat in navbarCategories.Take(5))
                    {
                        var displayName = toDisplay(cat.Name);
                        <a asp-controller="Category" asp-action="Load" asp-route-name="@cat.Name">@displayName</a>
                    }
                </div>
                <button type="button" class="mobile-cat-more" id="mobileMenuOpen" aria-label="More categories">
                    More <i class="fa-solid fa-chevron-down"></i>
                </button>
            </div>
        </div>

        <div class="mobile-search-bar" id="mobileSearchBar">
            <form role="search" method="get" action="#">
                <input type="text" name="q" placeholder="Search for Products..." aria-label="Search" />
                <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
        </div>
    </header>

    <!-- ================= MOBILE DRAWER ================= -->
    <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
    <div class="mobile-drawer" id="mobileDrawer">
        <div class="mobile-drawer-header">
            <a href="/" class="drawer-logo">
                <img src="https://i.ibb.co.com/DfjPHZtK/al-ibtisam-logo.webp" alt="al_ibtisam" />
            </a>
            <button class="drawer-close" id="mobileMenuClose" aria-label="Close menu">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="mobile-drawer-body">
            <ul>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li>
                        <a asp-controller="Account" asp-action="Profile" style="color:var(--theme-secondary); font-weight:700;">
                            <span><i class="fa-solid fa-user" style="color:var(--theme-secondary); margin-right:8px;"></i> @User.Identity.Name</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a asp-controller="Account" asp-action="SignIn" style="color:var(--theme-secondary); font-weight:700;">
                            <span><i class="fa-regular fa-user" style="color:var(--theme-secondary); margin-right:8px;"></i> Sign In / Sign Up</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                }

                @foreach (var cat in navbarCategories)
                {
                    var displayName = toDisplay(cat.Name);

                    <li>
                        <a asp-controller="Category" asp-action="Load" asp-route-name="@cat.Name"
                           class="@(cat.IsFlashSale ? "flash" : "")">
                            @displayName <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="mobile-drawer-footer">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-controller="Account" asp-action="SignOut" method="post" style="flex:1; margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="width:100%; height:48px; border-radius:6px; background:#c62828; color:#fff; font-size:14px; font-weight:700; border:0; cursor:pointer;">
                        <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="SignIn">Sign In</a>
                <a asp-controller="Account" asp-action="SignUp">Sign Up</a>
            }
        </div>
    </div>

    <!-- ================= CART DRAWER ================= -->
    <div class="cart-drawer-overlay" id="cartDrawerOverlay"></div>
    <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping Cart">
        <div class="cart-drawer-header">
            <h3>Shopping Cart</h3>
            <button type="button" class="cart-drawer-close" id="cartDrawerClose" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="cart-drawer-body" id="cartDrawerBody"></div>
        <div class="cart-drawer-footer">
            <div class="cart-subtotal">
                <span>Subtotal:</span>
                <strong id="cartSubtotal">৳0</strong>
            </div>
            <a asp-controller="Checkout" asp-action="Checkout" class="cart-checkout-btn">Checkout</a>
        </div>
    </aside>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="site-footer">
        <div class="site-container">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="footer-logo" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="https://i.ibb.co.com/DfjPHZtK/al-ibtisam-logo.webp" alt="al_ibtisam" />
                    </a>
                    <p class="footer-about">Quality fashion and lifestyle products, carefully selected and delivered right to your doorstep.</p>
                    <ul class="footer-contact">
                        <li><i class="fa-solid fa-phone-volume"></i><span>Hotline: <strong>09638090000</strong></span></li>
                        <li><i class="fa-regular fa-envelope"></i><a href="mailto:info@yourdomain.com">info@yourdomain.com</a></li>
                        <li><i class="fa-solid fa-location-dot"></i><a href="#">Find our stores</a></li>
                    </ul>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>

                <div class="footer-col">
                    <h4>Shop</h4>
                    <ul>
                        @foreach (var cat in navbarCategories.Take(9))
                        {
                            var displayName = toDisplay(cat.Name);
                            <li><a asp-controller="Category" asp-action="Load" asp-route-name="@cat.Name">@displayName</a></li>
                        }
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Customer Care</h4>
                    <ul>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">Store Locations</a></li>
                        <li><a href="#">Track Your Order</a></li>
                        <li><a href="#">Shipping &amp; Delivery</a></li>
                        <li><a href="#">Return &amp; Exchange</a></li>
                        <li><a href="#">FAQ</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="#">About Us</a></li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li><a asp-controller="Account" asp-action="Profile">My Account</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="SignIn">My Account</a></li>
                        }

                        <li><a asp-controller="Wishlist" asp-action="Wishlist">My Wishlist</a></li>
                        <li><a href="#">Terms &amp; Conditions</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="site-container footer-bottom-inner">
                <div class="footer-copy">&copy; 2026 al_ibtisam. All rights reserved.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            // ==========================================
            // Account Dropdown Toggle (Desktop)
            // ==========================================
            var accountDropdown = document.getElementById('accountDropdown');
            var accountToggle = document.getElementById('accountToggle');

            if (accountToggle && accountDropdown) {
                accountToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    accountDropdown.classList.toggle('open');
                });

                document.addEventListener('click', function (e) {
                    if (!accountDropdown.contains(e.target)) {
                        accountDropdown.classList.remove('open');
                    }
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        accountDropdown.classList.remove('open');
                    }
                });
            }

            // ==========================================
            // Mobile drawer
            // ==========================================
            var openBtn = document.getElementById('mobileMenuOpen');
            var closeBtn = document.getElementById('mobileMenuClose');
            var drawer = document.getElementById('mobileDrawer');
            var overlay = document.getElementById('mobileDrawerOverlay');

            function openDrawer() {
                drawer.classList.add('open');
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
            function closeDrawer() {
                drawer.classList.remove('open');
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }
            if (openBtn) openBtn.addEventListener('click', openDrawer);
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
            if (overlay) overlay.addEventListener('click', closeDrawer);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeDrawer();
            });

            // ==========================================
            // Mobile search
            // ==========================================
            var searchToggle = document.getElementById('mobileSearchToggle');
            var searchBar = document.getElementById('mobileSearchBar');
            if (searchToggle && searchBar) {
                searchToggle.addEventListener('click', function () {
                    searchBar.classList.toggle('open');
                    if (searchBar.classList.contains('open')) {
                        var input = searchBar.querySelector('input');
                        if (input) input.focus();
                    }
                });
            }

            // ==========================================
            // Wishlist badge
            // ==========================================
            fetch('/Wishlist/Count')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var badge = document.getElementById('wishlistCountBadge');
                    if (badge) badge.textContent = data.count;
                    var badgeM = document.getElementById('wishlistCountBadgeMobile');
                    if (badgeM) badgeM.textContent = data.count;
                })
                .catch(function () { });

            // ==========================================
            // Cart drawer
            // ==========================================
            var cartDrawer = document.getElementById('cartDrawer');
            var cartOverlay = document.getElementById('cartDrawerOverlay');
            var cartLink = document.getElementById('cartLink');
            var cartLinkMobile = document.getElementById('cartLinkMobile');
            var cartClose = document.getElementById('cartDrawerClose');
            var cartBody = document.getElementById('cartDrawerBody');
            var cartSubtotalEl = document.getElementById('cartSubtotal');

            function openCart() {
                cartDrawer.classList.add('open');
                cartOverlay.classList.add('show');
                document.body.style.overflow = 'hidden';
                loadCartItems();
            }
            function closeCart() {
                cartDrawer.classList.remove('open');
                cartOverlay.classList.remove('show');
                document.body.style.overflow = '';
            }
            if (cartLink) cartLink.addEventListener('click', openCart);
            if (cartLinkMobile) cartLinkMobile.addEventListener('click', openCart);
            if (cartClose) cartClose.addEventListener('click', closeCart);
            if (cartOverlay) cartOverlay.addEventListener('click', closeCart);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeCart();
            });

            function loadCartItems() {
                fetch('/Cart/Items')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        updateCartBadge(data.count);
                        cartSubtotalEl.textContent = '৳' + (data.subtotal || 0).toLocaleString('en-BD');
                        if (!data.items || data.items.length === 0) {
                            cartBody.innerHTML =
                                '<div class="cart-empty">' +
                                '<i class="fa-solid fa-bag-shopping"></i>' +
                                '<p>Your cart is empty</p>' +
                                '</div>';
                            return;
                        }
                        var html = '';
                        data.items.forEach(function (item) {
                            html +=
                                '<div class="cart-item" data-id="' + item.productId + '" data-size="' + item.size + '">' +
                                '<div class="cart-item-img"><img src="' + item.imageUrl + '" alt="' + item.name + '" /></div>' +
                                '<div class="cart-item-info">' +
                                '<h4 class="cart-item-name">' + item.name + '</h4>' +
                                '<span class="cart-item-size">Size: ' + (item.size || '-') + '</span>' +
                                '<div class="cart-item-price-row">' +
                                '<span class="cart-item-original">Original price: ৳' + item.price + '</span>' +
                                '</div>' +
                                '<div class="cart-item-price-row">' +
                                '<span class="cart-item-price">৳' + item.price + '</span> ' +
                                '<span class="cart-item-qty">x' + item.quantity + '</span>' +
                                '</div>' +
                                '</div>' +
                                '<button type="button" class="cart-item-remove" data-id="' + item.productId + '" data-size="' + item.size + '" aria-label="Remove">' +
                                '<i class="fa-solid fa-xmark"></i>' +
                                '</button>' +
                                '</div>';
                        });
                        cartBody.innerHTML = html;
                        bindRemoveButtons();
                    })
                    .catch(function (err) { console.error(err); });
            }

            function bindRemoveButtons() {
                document.querySelectorAll('.cart-item-remove').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var id = parseInt(btn.getAttribute('data-id'));
                        var size = btn.getAttribute('data-size') || '';
                        fetch('/Cart/Remove', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId: id, size: size })
                        })
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (data.success) {
                                    updateCartBadge(data.count);
                                    loadCartItems();
                                }
                            });
                    });
                });
            }

            function updateCartBadge(count) {
                var badge = document.getElementById('cartCountBadge');
                if (badge) badge.textContent = count;
                var badgeM = document.getElementById('cartCountBadgeMobile');
                if (badgeM) badgeM.textContent = count;
            }

            fetch('/Cart/Items')
                .then(function (r) { return r.json(); })
                .then(function (data) { updateCartBadge(data.count); })
                .catch(function () { });

            window.refreshCartBadge = function () {
                fetch('/Cart/Items')
                    .then(function (r) { return r.json(); })
                    .then(function (data) { updateCartBadge(data.count); })
                    .catch(function () { });
            };
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>