@model al_ibtisam.Models.Product
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
    var related = ViewBag.RelatedProducts as List<al_ibtisam.Models.Product>;
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=League+Spartan:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .product-page { font-family: 'Poppins', sans-serif; background: #E5FBFF; padding: 24px 0 60px; }

    /* Breadcrumb */
    .breadcrumb-area { font-size: 14px; color: #134856; margin-bottom: 22px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
    .breadcrumb-area a { color: #134856; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .breadcrumb-area a:hover { color: #028EA5; }
    .breadcrumb-area i { font-size: 11px; color: #028EA5; }

    /* Layout */
    .product-main { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; background: #fff; border-radius: 12px; padding: 30px; box-shadow: 0 1px 3px rgba(0,0,0,.05); }

    /* Gallery */
    .gallery { display: flex; gap: 14px; align-items: flex-start; }
    .gallery-thumbs { flex: 0 0 80px; display: flex; flex-direction: column; gap: 10px; }
    .thumb { width: 80px; height: 100px; border: 1.5px solid #E5FBFF; border-radius: 6px; overflow: hidden; cursor: pointer; background: #f3f3f3; transition: border-color .2s; }
    .thumb.active { border-color: #028EA5; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .gallery-main { flex: 1 1 auto; min-width: 0; aspect-ratio: 4 / 5; border-radius: 10px; overflow: hidden; background: #f3f3f3; position: relative; }
    .gallery-main img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Discount Badge - Action Color #86D200 */
    .discount-badge { position: absolute; top: 12px; left: 12px; background: #86D200; color: #134856; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 3px; z-index: 2; }

    /* Details */
    .details { display: flex; flex-direction: column; gap: 14px; }
    .product-brand-small { font-size: 14px; font-weight: 600; color: #6c8a93; letter-spacing: 1px; text-transform: uppercase; margin: 0; }
    .product-title { font-size: 26px; font-weight: 700; color: #134856; margin: 0; line-height: 1.3; }

    .stock-badge { display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 13px; font-weight: 600; width: fit-content; }
    .stock-badge.in-stock { background: #E5FBFF; color: #028EA5; }
    .stock-badge.out-stock { background: #fdeaea; color: #b71c1c; }

    .price-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-top: 4px; }

    /* Price / Number - #FFAA0D */
    .price-current { font-size: 28px; font-weight: 700; color: #FFAA0D; }
    .price-old { font-size: 18px; color: #6c8a93; text-decoration: line-through; font-weight: 400; }
    .price-save { font-size: 13px; color: #FFAA0D; font-weight: 600; background: #FFF7E0; padding: 3px 8px; border-radius: 4px; }

    .section-label { font-size: 15px; font-weight: 600; color: #134856; margin: 8px 0 0; }

    .size-options { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
    .size-btn { min-width: 50px; height: 44px; padding: 0 14px; border: 1.5px solid #E5FBFF; background: #fff; border-radius: 4px; font-size: 14px; font-weight: 500; color: #134856; cursor: pointer; transition: all .2s; font-family: 'Poppins', sans-serif; }
    .size-btn:hover:not(.disabled) { border-color: #028EA5; }
    .size-btn.active { background: #028EA5; color: #fff; border-color: #028EA5; }
    .size-btn.disabled { color: #b0d4dc; cursor: not-allowed; background: #fafafa; text-decoration: line-through; }

    .brand-row { font-size: 15px; color: #134856; margin-top: 4px; }
    .brand-row strong { color: #028EA5; font-weight: 600; }

    /* ================= QTY + ACTION BUTTONS ================= */
    .qty-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 8px;
        flex-wrap: wrap;
    }

    .qty-box {
        display: flex;
        align-items: center;
        height: 54px;
        border: 1.5px solid #E5FBFF;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
        flex: 0 0 auto;
    }

    .qty-box button {
        width: 50px;
        height: 100%;
        border: 0;
        background: #fff;
        font-size: 20px;
        color: #134856;
        cursor: pointer;
        transition: background .2s;
    }

    .qty-box button:hover { background: #E5FBFF; }

    .qty-box input {
        width: 60px;
        height: 100%;
        border: 0;
        outline: 0;
        text-align: center;
        font-size: 16px;
        font-weight: 600;
        color: #134856;
        background: #fff;
        font-family: 'Poppins', sans-serif;
    }

    /* Action Buttons - Side by Side */
    .action-buttons {
        display: flex;
        gap: 12px;
        margin-top: 4px;
        flex-wrap: wrap;
    }

    /* Add to Cart Button - #FFAA0D */
    .btn-cart {
        flex: 1 1 200px;
        height: 54px;
        border: 0;
        border-radius: 6px;
        background: #FFAA0D;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
        transition: background .2s, transform .1s, opacity .2s;
    }

    .btn-cart:hover { background: #e69900; }
    .btn-cart:active { transform: scale(.99); }
    .btn-cart:disabled { opacity: .7; cursor: not-allowed; }

    /* Buy Now Button - #86D200 */
    .btn-buy {
        flex: 1 1 200px;
        height: 54px;
        border: 0;
        border-radius: 6px;
        background: #86D200;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
        transition: background .2s, transform .1s, opacity .2s;
    }

    .btn-buy:hover { background: #76bb00; }
    .btn-buy:active { transform: scale(.99); }
    .btn-buy:disabled { opacity: .7; cursor: not-allowed; }

    /* Wishlist Inline - Action Color #86D200 */
    .wishlist-inline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border: 1.5px solid #86D200;
        border-radius: 6px;
        background: #fff;
        color: #134856;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 12px;
        width: fit-content;
        font-family: 'Poppins', sans-serif;
        transition: all .2s;
    }

    .wishlist-inline:hover, .wishlist-inline.active {
        border-color: #86D200;
        color: #134856;
        background: #F2FCDE;
    }

    /* Description */
    .description-section { margin-top: 30px; background: #fff; border-radius: 12px; padding: 30px; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .desc-heading { font-size: 22px; font-weight: 700; color: #028EA5; margin: 0 0 14px; }
    .desc-text { font-size: 15px; line-height: 1.75; color: #134856; margin: 0 0 24px; }
    .desc-text i { color: #028EA5; margin-right: 6px; }

    .size-chart-block { margin: 26px 0; }
    .size-chart-block h5 { font-size: 17px; font-weight: 700; color: #134856; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
    .size-chart-block h5::before { content: ""; width: 4px; height: 20px; background: #028EA5; border-radius: 2px; display: inline-block; }
    .size-chart-img { width: 100%; max-width: 900px; border-radius: 8px; overflow: hidden; border: 1px solid #E5FBFF; background: #fafbfc; }
    .size-chart-img img { width: 100%; height: auto; display: block; }

    .features-block, .love-block { margin: 26px 0; }
    .features-block h5, .love-block h5 { font-size: 17px; font-weight: 700; color: #134856; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
    .features-block h5::before, .love-block h5::before { content: ""; width: 4px; height: 20px; background: #028EA5; border-radius: 2px; display: inline-block; }
    .features-list { list-style: none; padding: 0; margin: 0; }
    .features-list li { font-size: 15px; color: #134856; line-height: 1.75; padding: 4px 0; display: flex; gap: 10px; }
    .features-list li::before { content: "•"; color: #028EA5; font-weight: 900; flex: 0 0 auto; }

    .love-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; }
    .love-list li { font-size: 15px; color: #134856; line-height: 1.7; display: flex; gap: 8px; align-items: flex-start; }
    .love-list li::before { content: "✅"; font-size: 14px; flex: 0 0 auto; }

    .disclaimer-block { margin-top: 28px; padding: 16px 20px; background: #E5FBFF; border-left: 4px solid #028EA5; border-radius: 6px; }
    .disclaimer-block p { font-size: 14px; line-height: 1.7; color: #134856; margin: 0; }
    .disclaimer-block strong { color: #028EA5; }

    /* Related */
    .related-section { margin-top: 40px; }
    .related-title { font-size: 22px; font-weight: 700; color: #028EA5; margin: 0 0 20px; }
    .related-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
    .related-card { background: #fff; border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s; display: flex; flex-direction: column; }
    .related-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(2, 142, 165, 0.15); }
    .related-img { position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: #f3f3f3; }
    .related-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .related-info { padding: 10px 12px 14px; }
    .related-name { font-size: 13.5px; font-weight: 600; color: #134856; margin: 0 0 4px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 36px; }
    .related-price { font-size: 14px; font-weight: 700; color: #FFAA0D; margin: 0; }

    /* Responsive */
    @@media (max-width: 991.98px) {
        .product-main { grid-template-columns: 1fr; gap: 30px; padding: 20px; }
        .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .love-list { grid-template-columns: 1fr; }
        .description-section { padding: 22px; }
    }

    @@media (max-width: 767.98px) {
        .product-page { padding: 14px 0 40px; }
        .product-main { padding: 14px; }
        .gallery { flex-direction: column-reverse; }
        .gallery-thumbs { flex: 1 1 auto; flex-direction: row; width: 100%; overflow-x: auto; }
        .thumb { flex: 0 0 64px; width: 64px; height: 80px; }
        .product-title { font-size: 20px; }
        .price-current { font-size: 22px; }
        .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .description-section { padding: 16px; }
        .desc-heading { font-size: 18px; }

        .qty-row { gap: 10px; }
        .qty-box { height: 50px; }
        .qty-box button { width: 42px; font-size: 18px; }
        .qty-box input { width: 50px; font-size: 15px; }

        .action-buttons { gap: 10px; }
        .btn-cart, .btn-buy { flex: 1 1 140px; height: 50px; font-size: 14px; }
    }

    @@media (max-width: 480px) {
        .qty-row { flex-direction: column; align-items: stretch; }
        .qty-box { width: 100%; justify-content: center; }
        .qty-box input { width: 80px; }
        .action-buttons { flex-direction: column; }
        .btn-cart, .btn-buy { flex: 1 1 auto; width: 100%; }
    }

    .toast-msg { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #134856; color: #fff; padding: 10px 22px; border-radius: 8px; font-size: 14px; z-index: 9999; opacity: 0; transition: opacity .25s; font-family: 'Poppins', sans-serif; }
</style>

<div class="container product-page">

    <div class="breadcrumb-area">
        <a href="/"><i class="fa-solid fa-house"></i> Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a asp-controller="Category" asp-action="@Model.CategoryName.Replace(" ", "").Replace("&", "")">@Model.CategoryName</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>@Model.Name</span>
    </div>

    <div class="product-main">

        <!-- GALLERY -->
        <div class="gallery">
            <div class="gallery-thumbs" id="galleryThumbs">
                @{
                    var images = new List<string> { Model.ImageUrl };
                    if (Model.GalleryImages != null && Model.GalleryImages.Length > 0)
                    {
                        foreach (var img in Model.GalleryImages)
                        {
                            if (!string.IsNullOrEmpty(img) && img != Model.ImageUrl)
                            {
                                images.Add(img);
                            }
                        }
                    }
                    else
                    {
                        images.Add(Model.ImageUrl);
                    }
                }
                @for (int i = 0; i < images.Count; i++)
                {
                    <div class="thumb @(i == 0 ? "active" : "")" data-src="@images[i]">
                        <img src="@images[i]" alt="@Model.Name" />
                    </div>
                }
            </div>

            <div class="gallery-main">
                @if (Model.DiscountPercent.HasValue && Model.DiscountPercent > 0)
                {
                    <span class="discount-badge">@Model.DiscountPercent%</span>
                }
                <img id="mainImage" src="@Model.ImageUrl" alt="@Model.Name" />
            </div>
        </div>

        <!-- DETAILS -->
        <div class="details">

            @if (!string.IsNullOrEmpty(Model.Brand))
            {
                <p class="product-brand-small">@Model.Brand</p>
            }

            <h1 class="product-title">@Model.Name</h1>

            @if (Model.InStock)
            {
                <span class="stock-badge in-stock">In Stock</span>
            }
            else
            {
                <span class="stock-badge out-stock">Out of Stock</span>
            }

            <div class="price-row">
                <span class="price-current">৳@Model.Price.ToString("0")</span>
                @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
                {
                    <span class="price-old">৳@Model.OldPrice.Value.ToString("0")</span>
                    <span class="price-save">Save ৳@((Model.OldPrice.Value - Model.Price).ToString("0"))</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p style="font-size:14.5px; color:#134856; line-height:1.7; margin:6px 0 0;">
                    <span style="color:#028EA5;">✨</span> @Model.ShortDescription
                </p>
            }

            @if (Model.Sizes != null && Model.Sizes.Length > 0)
            {
                <p class="section-label">Select Size:</p>
                <div class="size-options" id="sizeOptions">
                    @foreach (var size in Model.Sizes)
                    {
                        <button type="button" class="size-btn" data-size="@size">@size</button>
                    }
                </div>
            }

            <p class="brand-row">Brand: <strong>@Model.Brand</strong></p>

            <p class="section-label" style="margin-top:12px;">Quantity</p>

            <!-- QTY + ACTION BUTTONS TOGETHER -->
            <div class="qty-row">
                <div class="qty-box">
                    <button type="button" id="qtyMinus">−</button>
                    <input type="text" id="qtyInput" value="1" readonly />
                    <button type="button" id="qtyPlus">+</button>
                </div>

                <div class="action-buttons">
                    <button type="button" class="btn-cart" id="addToCartBtn">Add To Cart</button>
                    <button type="button" class="btn-buy" id="buyNowBtn">Buy Now</button>
                </div>
            </div>

            <button type="button" class="wishlist-inline" id="wishlistBtn" data-product-id="@Model.Id">
                <i class="fa-regular fa-heart"></i>
                <span>Add to Wishlist</span>
            </button>
        </div>
    </div>

    <!-- DESCRIPTION -->
    <div class="description-section">
        <h2 class="desc-heading">Product Description</h2>

        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="desc-text">
                <i class="fa-solid fa-sparkles"></i> @Model.ShortDescription
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.SizeChartImageUrl))
        {
            <div class="size-chart-block">
                <h5>Size Chart</h5>
                <div class="size-chart-img">
                    <img src="@Model.SizeChartImageUrl" alt="@Model.Name Size Chart" />
                </div>
            </div>
        }

        @if (Model.KeyFeatures != null && Model.KeyFeatures.Length > 0)
        {
            <div class="features-block">
                <h5>📌 Key Features &amp; Specifications</h5>
                <ul class="features-list">
                    @foreach (var f in Model.KeyFeatures)
                    {
                        <li>@f</li>
                    }
                </ul>
            </div>
        }

        @if (Model.WhyYouWillLoveIt != null && Model.WhyYouWillLoveIt.Length > 0)
        {
            <div class="love-block">
                <h5>⭐ Why You'll Love It</h5>
                <ul class="love-list">
                    @foreach (var w in Model.WhyYouWillLoveIt)
                    {
                        <li>@w</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ColorDisclaimer))
        {
            <div class="disclaimer-block">
                <p><strong>⚠️ Color/Image Disclaimer:</strong> @Model.ColorDisclaimer</p>
            </div>
        }
    </div>

    <!-- RELATED -->
    @if (related != null && related.Any())
    {
        <div class="related-section">
            <h2 class="related-title">Related Products</h2>
            <div class="related-grid">
                @foreach (var p in related)
                {
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Id" class="related-card">
                        <div class="related-img">
                            @if (p.DiscountPercent.HasValue && p.DiscountPercent > 0)
                            {
                                <span class="discount-badge">@p.DiscountPercent%</span>
                            }
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        </div>
                        <div class="related-info">
                            <h3 class="related-name">@p.Name</h3>
                            <p class="related-price">৳@p.Price.ToString("0")</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // GALLERY
            var mainImage = document.getElementById('mainImage');
            document.querySelectorAll('#galleryThumbs .thumb').forEach(function (t) {
                t.addEventListener('click', function () {
                    var src = t.getAttribute('data-src');
                    if (mainImage && src) mainImage.src = src;
                    document.querySelectorAll('#galleryThumbs .thumb').forEach(function (x) {
                        x.classList.remove('active');
                    });
                    t.classList.add('active');
                });
            });

            // SIZE
            var sizeOptions = document.getElementById('sizeOptions');
            if (sizeOptions) {
                sizeOptions.querySelectorAll('.size-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        if (btn.classList.contains('disabled')) return;
                        sizeOptions.querySelectorAll('.size-btn').forEach(function (x) {
                            x.classList.remove('active');
                        });
                        btn.classList.add('active');
                    });
                });
            }

            // QTY
            var qtyInput = document.getElementById('qtyInput');
            var qtyMinus = document.getElementById('qtyMinus');
            var qtyPlus = document.getElementById('qtyPlus');

            function updateQty(delta) {
                var current = parseInt(qtyInput.value) || 1;
                var next = current + delta;
                if (next < 1) next = 1;
                if (next > 99) next = 99;
                qtyInput.value = next;
            }
            if (qtyMinus) qtyMinus.addEventListener('click', function () { updateQty(-1); });
            if (qtyPlus) qtyPlus.addEventListener('click', function () { updateQty(1); });

            // ADD TO CART
            var addBtn = document.getElementById('addToCartBtn');
            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    var sizeBtn = document.querySelector('#sizeOptions .size-btn.active');
                    if (sizeOptions && !sizeBtn) {
                        showToast('Please select a size first');
                        return;
                    }
                    var productId = parseInt('@Model.Id');
                    var size = sizeBtn ? sizeBtn.getAttribute('data-size') : '';
                    var qty = parseInt(document.getElementById('qtyInput').value) || 1;

                    addBtn.disabled = true;
                    addBtn.innerHTML = 'Adding...';

                    fetch('/Cart/Add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: productId, size: size, quantity: qty })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        addBtn.disabled = false;
                        if (data.success) {
                            addBtn.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
                            addBtn.style.background = '#e69900';
                            setTimeout(function () {
                                addBtn.innerHTML = 'Add To Cart';
                                addBtn.style.background = '';
                            }, 1400);
                            if (window.refreshCartBadge) window.refreshCartBadge();
                            showToast('Added to cart');
                        } else {
                            addBtn.innerHTML = 'Add To Cart';
                            showToast(data.message || 'Failed to add');
                        }
                    })
                    .catch(function (err) {
                        console.error(err);
                        addBtn.disabled = false;
                        addBtn.innerHTML = 'Add To Cart';
                        showToast('Something went wrong');
                    });
                });
            }

            // BUY NOW
            var buyBtn = document.getElementById('buyNowBtn');
            if (buyBtn) {
                buyBtn.addEventListener('click', function () {
                    var sizeBtn = document.querySelector('#sizeOptions .size-btn.active');
                    if (sizeOptions && !sizeBtn) {
                        showToast('Please select a size first');
                        return;
                    }
                    var productId = parseInt('@Model.Id');
                    var size = sizeBtn ? sizeBtn.getAttribute('data-size') : '';
                    var qty = parseInt(document.getElementById('qtyInput').value) || 1;

                    buyBtn.disabled = true;
                    buyBtn.innerHTML = 'Redirecting...';

                    fetch('/Checkout/SetBuyNow', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: productId, size: size, quantity: qty })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) {
                            window.location.href = '/Checkout/BuyNowCheckout';
                        } else {
                            buyBtn.disabled = false;
                            buyBtn.innerHTML = 'Buy Now';
                            showToast(data.message || 'Failed to proceed');
                        }
                    })
                    .catch(function (err) {
                        console.error(err);
                        buyBtn.disabled = false;
                        buyBtn.innerHTML = 'Buy Now';
                        showToast('Something went wrong');
                    });
                });
            }

            // WISHLIST
            var wishBtn = document.getElementById('wishlistBtn');
            if (wishBtn) {
                var pid = wishBtn.getAttribute('data-product-id');
                wishBtn.addEventListener('click', function () {
                    fetch('/Wishlist/Toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: parseInt(pid) })
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) return;
                        var icon = wishBtn.querySelector('i');
                        var span = wishBtn.querySelector('span');
                        if (data.added) {
                            wishBtn.classList.add('active');
                            icon.classList.remove('fa-regular');
                            icon.classList.add('fa-solid');
                            span.textContent = 'In Wishlist';
                        } else {
                            wishBtn.classList.remove('active');
                            icon.classList.remove('fa-solid');
                            icon.classList.add('fa-regular');
                            span.textContent = 'Add to Wishlist';
                        }
                        var badge = document.getElementById('wishlistCountBadge');
                        if (badge) badge.textContent = data.count;
                        var badgeM = document.getElementById('wishlistCountBadgeMobile');
                        if (badgeM) badgeM.textContent = data.count;
                        showToast(data.message);
                    })
                    .catch(function (err) { console.error(err); });
                });
            }

            // TOAST
            function showToast(msg) {
                var t = document.createElement('div');
                t.className = 'toast-msg';
                t.textContent = msg;
                document.body.appendChild(t);
                requestAnimationFrame(function () { t.style.opacity = '1'; });
                setTimeout(function () {
                    t.style.opacity = '0';
                    setTimeout(function () { t.remove(); }, 300);
                }, 1600);
            }
        })();
    </script>
}