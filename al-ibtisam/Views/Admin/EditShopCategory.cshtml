@model al_ibtisam.Models.Category
@{
    ViewData["Title"] = "Edit Shop Category";
    ViewData["ActiveNav"] = "ShopCategories";
    ViewData["PageTitle"] = "Edit Shop Category";
    ViewData["PageSubTitle"] = "ক্যাটাগরির নাম এবং আইকন আপডেট করুন";
    Layout = "_AdminLayout";
}

<style>
    /* ================= FORM CARD ================= */
    .form-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 30px;
        max-width: 600px;
    }
    
    .form-group { margin-bottom: 22px; }
    
    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
    }
    
    .form-control {
        width: 100%;
        height: 48px;
        padding: 0 16px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 14px;
        color: #134856;
        outline: none;
        font-family: inherit;
        transition: border-color .2s, box-shadow .2s;
    }
    
    .form-control:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }

    /* ================= CURRENT ICON BLOCK ================= */
    .current-icon-block {
        background: #f7fafc;
        border: 1.5px dashed #b0d4dc;
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
    }
    
    .current-icon-block img {
        width: 60px;
        height: 60px;
        object-fit: contain;
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e0e6ed;
        padding: 4px;
        flex: 0 0 auto;
    }

    .current-icon-info strong {
        display: block;
        font-size: 13.5px;
        color: #028EA5;
        margin-bottom: 4px;
    }
    
    .current-icon-info small {
        font-size: 12.5px;
        color: #6c8a93;
        line-height: 1.5;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= IMAGE UPLOAD BOX ================= */
    .img-upload-box {
        border: 2px dashed #b0d4dc;
        border-radius: 10px;
        padding: 24px;
        text-align: center;
        background: #f7fafc;
        cursor: pointer;
        position: relative;
        transition: border-color .2s, background .2s;
    }
    
    .img-upload-box:hover, 
    .img-upload-box.dragover { 
        border-color: #028EA5; 
        background: #eaf9fc; 
    }
    
    .img-upload-box input[type="file"] {
        position: absolute; 
        inset: 0; 
        opacity: 0; 
        width: 100%; 
        height: 100%; 
        cursor: pointer; 
        z-index: 2;
    }
    
    .img-upload-box i { 
        font-size: 28px; 
        color: #028EA5; 
        margin-bottom: 8px; 
        display: block; 
        pointer-events: none; 
    }
    
    .img-upload-box p { 
        margin: 0; 
        font-size: 13.5px; 
        color: #134856; 
        font-weight: 500; 
        pointer-events: none; 
    }
    
    .img-upload-box small { 
        font-size: 12px; 
        color: #6c8a93; 
        display: block; 
        margin-top: 4px; 
        pointer-events: none; 
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= NEW IMAGE PREVIEW ================= */
    .img-preview {
        margin-top: 14px;
        border-radius: 8px;
        overflow: hidden;
        max-width: 100px;
        border: 2px solid #028EA5;
        background: #fff;
        box-shadow: 0 4px 14px rgba(2, 142, 165, .15);
        display: none;
        position: relative;
    }
    
    .img-preview img { 
        width: 100%; 
        height: auto; 
        display: block; 
    }

    .img-preview .new-tag {
        position: absolute;
        top: 4px;
        left: 4px;
        background: #86D200;
        color: #134856;
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 3px;
    }

    /* ================= BUTTONS ================= */
    .btn-row { 
        display: flex; 
        gap: 12px; 
        margin-top: 10px; 
        padding-top: 20px; 
        border-top: 1px solid #f0f4f8; 
        flex-wrap: wrap;
    }
    
    .btn-submit {
        height: 48px; 
        padding: 0 30px; 
        background: #028EA5; 
        color: #fff;
        border: 0; 
        border-radius: 8px; 
        font-size: 14px; 
        font-weight: 600;
        cursor: pointer; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px;
        transition: background .2s;
        font-family: inherit;
    }
    
    .btn-submit:hover { background: #134856; }
    .btn-submit:disabled { opacity: .7; cursor: not-allowed; }

    .btn-cancel {
        height: 48px; 
        padding: 0 24px; 
        background: #e0e6ed; 
        color: #134856;
        border-radius: 8px; 
        text-decoration: none; 
        font-weight: 600; 
        font-size: 14px;
        display: inline-flex; 
        align-items: center; 
        gap: 8px;
        transition: background .2s;
    }
    
    .btn-cancel:hover { background: #cdd6e0; }

    /* ================= ALERTS ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
    }

    .alert-error {
        background: #fdeaea;
        border: 1px solid #f5c2c2;
        color: #b71c1c;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 768px) {
        .form-card { padding: 20px; }
        .btn-row { flex-direction: column; }
        .btn-submit, .btn-cancel { width: 100%; justify-content: center; }
    }
</style>

@* ================= ERROR ALERT ================= *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="form-card">
    <form asp-controller="Admin" asp-action="EditShopCategory" method="post" enctype="multipart/form-data" novalidate id="editCatForm">
        @Html.AntiForgeryToken()
        
        <!-- Hidden ID -->
        <input type="hidden" name="id" value="@Model.Id" />

        <!-- Category Name -->
        <div class="form-group">
            <label>Category Name <span style="color:#c62828;">*</span></label>
            <input type="text" 
                   name="categoryName" 
                   id="categoryNameInput"
                   class="form-control" 
                   value="@Model.Name" 
                   required 
                   maxlength="100" />
        </div>

        <!-- Current Icon -->
        <div class="form-group">
            <label>Current Icon</label>
            @if (!string.IsNullOrEmpty(Model.IconUrl))
            {
                <div class="current-icon-block">
                    <img src="@Model.IconUrl" alt="Current Icon" />
                    <div class="current-icon-info">
                        <strong>বর্তমান আইকন</strong>
                        <small>নতুন আইকন আপলোড করলে এটি স্বয়ংক্রিয়ভাবে পরিবর্তন হয়ে যাবে।</small>
                    </div>
                </div>
            }
            else
            {
                <div class="current-icon-block" style="border-color: #ffe082; background: #fff8e1;">
                    <div style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 8px; border: 1px solid #e0e6ed; color: #a0b2b8; font-size: 20px; flex: 0 0 auto;">
                        <i class="fa-solid fa-image"></i>
                    </div>
                    <div class="current-icon-info">
                        <strong style="color: #e65100;">কোনো আইকন নেই</strong>
                        <small>এই ক্যাটাগরির জন্য এখনো কোনো আইকন আপলোড করা হয়নি।</small>
                    </div>
                </div>
            }
        </div>

        <!-- Upload New Icon -->
        <div class="form-group">
            <label>Upload New Icon (Optional)</label>
            <div class="img-upload-box" id="iconUploadBox">
                <input type="file" 
                       name="iconFile" 
                       accept="image/*" 
                       onchange="previewImage(this)" />
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p>নতুন আইকন আপলোড করুন</p>
                <small>না দিলে পুরনো আইকনই থাকবে • JPG, PNG, SVG • সর্বোচ্চ 2MB</small>
            </div>
            
            <!-- New Image Preview -->
            <div class="img-preview" id="iconPreview">
                <span class="new-tag">NEW</span>
                <img src="" alt="New Icon Preview" />
            </div>
        </div>

        <!-- Submit Buttons -->
        <div class="btn-row">
            <button type="submit" class="btn-submit" id="saveBtn">
                <i class="fa-solid fa-save"></i> Save Changes
            </button>
            <a asp-controller="Admin" asp-action="ShopCategories" class="btn-cancel">
                <i class="fa-solid fa-xmark"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ==========================================
        // Image Preview Function
        // ==========================================
        function previewImage(input) {
            var preview = document.getElementById('iconPreview');
            var img = preview.querySelector('img');
            
            if (input.files && input.files[0]) {
                var file = input.files[0];
                
                if (!file.type.startsWith('image/')) {
                    alert('শুধু ইমেজ ফাইল সিলেক্ট করুন');
                    input.value = '';
                    preview.style.display = 'none';
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert('আইকনের সাইজ ২MB এর কম হতে হবে');
                    input.value = '';
                    preview.style.display = 'none';
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
            }
        }

        // ==========================================
        // Drag & Drop Effect
        // ==========================================
        var uploadBox = document.getElementById('iconUploadBox');
        if (uploadBox) {
            ['dragenter', 'dragover'].forEach(function (ev) {
                uploadBox.addEventListener(ev, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadBox.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(function (ev) {
                uploadBox.addEventListener(ev, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadBox.classList.remove('dragover');
                });
            });
        }

        // ==========================================
        // Submit Button Loading State
        // ==========================================
        var form = document.getElementById('editCatForm');
        var btn = document.getElementById('saveBtn');
        var nameInput = document.getElementById('categoryNameInput');

        if (form && btn) {
            form.addEventListener('submit', function (e) {
                var val = nameInput ? nameInput.value.trim() : '';
                if (val.length === 0) {
                    e.preventDefault();
                    alert('ক্যাটাগরির নাম দিন');
                    if (nameInput) nameInput.focus();
                    return;
                }
                
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
            });
        }
    </script>
}