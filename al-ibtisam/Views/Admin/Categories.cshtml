@{
    ViewData["Title"] = "Categories Management";
    ViewData["ActiveNav"] = "Categories";
    ViewData["PageTitle"] = "Categories";
    ViewData["PageSubTitle"] = "ক্যাটাগরি যোগ করুন, Navbar-এ দেখান বা লুকান";
    Layout = "_AdminLayout";

    // Controller থেকে পাঠানো ডাটা
    var categoriesData = ViewBag.CategoriesData as IEnumerable<dynamic>;

    // Navbar-এ কতগুলো দেখাচ্ছে সেটা গণনা
    int navbarCount = 0;
    if (categoriesData != null)
    {
        foreach (var c in categoriesData)
        {
            if (c.ShowInNavbar) navbarCount++;
        }
    }
}

<style>
    /* ================= LAYOUT ================= */
    .category-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 24px;
        align-items: flex-start;
    }

    /* ================= LIST CARD ================= */
    .list-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden;
    }
    .list-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef2f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .list-header h2 {
        font-size: 18px;
        font-weight: 700;
        color: #134856;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .list-header h2 i { color: #028EA5; }

    .header-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .stat-badge {
        font-size: 12.5px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .stat-badge.total {
        background: #f0f4f8;
        color: #6c8a93;
    }
    .stat-badge.visible {
        background: #e8f5e9;
        color: #2e7d32;
    }
    .stat-badge.hidden {
        background: #fdeaea;
        color: #c62828;
    }

    /* ================= TABLE ================= */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    thead { background: #f7fafc; }
    thead th {
        text-align: left;
        padding: 14px 20px;
        font-size: 12.5px;
        font-weight: 700;
        color: #6c8a93;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
        border-bottom: 1px solid #eef2f5;
    }
    tbody tr {
        border-bottom: 1px solid #f4f7fa;
        transition: background .15s;
    }
    tbody tr:hover { background: #f9fbfc; }
    tbody tr:last-child { border-bottom: 0; }
    tbody td {
        padding: 16px 20px;
        color: #134856;
        vertical-align: middle;
    }

    .cat-name {
        font-weight: 600;
        font-size: 15px;
        color: #134856;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .cat-name i.tag-icon { color: #86D200; font-size: 14px; }
    .cat-name i.flash-icon { color: #ff5722; font-size: 14px; }

    .order-badge {
        display: inline-block;
        min-width: 30px;
        text-align: center;
        padding: 3px 8px;
        border-radius: 6px;
        background: #f0f4f8;
        color: #6c8a93;
        font-size: 12px;
        font-weight: 600;
    }

    .product-count-badge {
        background: #e3f2fd;
        color: #1565c0;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }
    .product-count-badge.empty {
        background: #f7fafc;
        color: #a0b2b8;
    }

    /* ================= TOGGLE SWITCH ================= */
    .toggle-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
        flex: 0 0 auto;
    }
    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ccc;
        border-radius: 999px;
        transition: background .25s;
    }
    .toggle-slider::before {
        content: "";
        position: absolute;
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform .25s;
        box-shadow: 0 2px 4px rgba(0,0,0,.2);
    }
    .toggle-switch input:checked + .toggle-slider {
        background: #86D200;
    }
    .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(24px);
    }
    .toggle-switch input:disabled + .toggle-slider {
        opacity: .6;
        cursor: not-allowed;
    }
    .toggle-label {
        font-size: 12.5px;
        font-weight: 600;
        white-space: nowrap;
    }
    .toggle-label.on { color: #2e7d32; }
    .toggle-label.off { color: #c62828; }

    /* ================= DELETE BUTTON ================= */
    .btn-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #fdeaea;
        color: #c62828;
        border: 0;
        cursor: pointer;
        transition: background .15s, color .15s;
    }
    .btn-delete:hover { background: #c62828; color: #fff; }
    .btn-delete:disabled {
        opacity: .4;
        cursor: not-allowed;
    }

    /* ================= ADD CARD ================= */
    .add-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 24px;
        position: sticky;
        top: 90px;
    }
    .add-card h3 {
        font-size: 16px;
        font-weight: 700;
        color: #134856;
        margin: 0 0 18px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f4f8;
    }
    .add-card h3 i { color: #028EA5; }

    .form-group { margin-bottom: 18px; }
    .form-group label {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
    }
    .form-control {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 14px;
        color: #134856;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        font-family: inherit;
        background: #fff;
    }
    .form-control:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }

    .btn-add {
        width: 100%;
        height: 48px;
        background: #86D200;
        color: #134856;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .2s, color .2s;
    }
    .btn-add:hover { background: #134856; color: #fff; }
    .btn-add:disabled { opacity: .7; cursor: not-allowed; }

    .info-box {
        background: #f0f9fb;
        border: 1px solid #b0d4dc;
        border-radius: 8px;
        padding: 12px 14px;
        margin-top: 16px;
        font-size: 12.5px;
        color: #134856;
        line-height: 1.6;
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }
    .info-box i {
        color: #028EA5;
        font-size: 14px;
        flex: 0 0 auto;
        margin-top: 2px;
    }

    /* ================= ALERTS ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
        animation: fadeIn .3s ease;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .alert-success {
        background: #e3f6ec;
        border: 1px solid #b3e2c6;
        color: #0f7b3e;
    }
    .alert-error {
        background: #fdeaea;
        border: 1px solid #f5c2c2;
        color: #b71c1c;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 991px) {
        .category-layout { grid-template-columns: 1fr; }
        .add-card { position: static; }
    }
    @@media (max-width: 575px) {
        .list-header { flex-direction: column; align-items: flex-start; }
        .header-stats { width: 100%; }
        thead th, tbody td { padding: 12px; font-size: 13px; }
        .product-count-badge { font-size: 11.5px; padding: 4px 10px; }
        .toggle-switch { width: 46px; height: 25px; }
        .toggle-slider::before { width: 19px; height: 19px; }
        .toggle-switch input:checked + .toggle-slider::before { transform: translateX(21px); }
    }
</style>

@* ================= ALERTS ================= *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="category-layout">

    <!-- ================= CATEGORY LIST ================= -->
    <div class="list-card">
        <div class="list-header">
            <h2><i class="fa-solid fa-layer-group"></i> All Categories</h2>
            <div class="header-stats">
                <span class="stat-badge total">
                    <i class="fa-solid fa-list"></i>
                    মোট @(categoriesData?.Count() ?? 0)
                </span>
                <span class="stat-badge visible">
                    <i class="fa-solid fa-eye"></i>
                    Navbar-এ @navbarCount
                </span>
                <span class="stat-badge hidden">
                    <i class="fa-solid fa-eye-slash"></i>
                    লুকানো @((categoriesData?.Count() ?? 0) - navbarCount)
                </span>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width:60px;">Order</th>
                        <th>Category Name</th>
                        <th>Products</th>
                        <th>Navbar-এ দেখাবে?</th>
                        <th style="text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (categoriesData != null && categoriesData.Any())
                    {
                        foreach (var cat in categoriesData)
                        {
                            var productCount = (int)cat.ProductCount;
                            var showNavbar = (bool)cat.ShowInNavbar;

                            <tr>
                                <!-- Order -->
                                <td>
                                    <span class="order-badge">@cat.DisplayOrder</span>
                                </td>

                                <!-- Name -->
                                <td>
                                    <div class="cat-name">
                                        @if ((bool)cat.IsFlashSale)
                                        {
                                            <i class="fa-solid fa-fire flash-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-tag tag-icon"></i>
                                        }
                                        @cat.Name
                                    </div>
                                </td>

                                <!-- Product Count -->
                                <td>
                                    @if (productCount > 0)
                                    {
                                        <span class="product-count-badge">
                                            @productCount টি প্রোডাক্ট
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-count-badge empty">
                                            0 টি
                                        </span>
                                    }
                                </td>

                                <!-- Navbar Toggle -->
                                <td>
                                    <form asp-controller="Admin"
                                          asp-action="ToggleNavbar"
                                          method="post"
                                          style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />

                                        <div class="toggle-wrap">
                                            <label class="toggle-switch" title="Navbar-এ দেখাবে কি না">
                                                <input type="checkbox"
                                                       @(showNavbar ? "checked" : "")
                                                       onchange="this.form.submit()" />
                                                <span class="toggle-slider"></span>
                                            </label>
                                            @if (showNavbar)
                                            {
                                                <span class="toggle-label on">দেখাবে</span>
                                            }
                                            else
                                            {
                                                <span class="toggle-label off">লুকানো</span>
                                            }
                                        </div>
                                    </form>
                                </td>

                                <!-- Delete -->
                                <td style="text-align:right;">
                                    <form asp-controller="Admin"
                                          asp-action="DeleteCategory"
                                          method="post"
                                          style="margin:0;"
                                          onsubmit="return confirmDelete('@cat.Name', @productCount);">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit"
                                                class="btn-delete"
                                                title="Delete Category"
                                                @(productCount > 0 ? "disabled" : "")>
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding:40px; color:#6c8a93;">
                                <i class="fa-solid fa-box-open"
                                   style="font-size:36px; color:#b0d4dc; display:block; margin-bottom:10px;"></i>
                                কোনো ক্যাটাগরি পাওয়া যায়নি।
                                <br />
                                <small style="font-size:12px;">
                                    ডান পাশের ফর্ম দিয়ে নতুন ক্যাটাগরি যোগ করুন।
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= ADD NEW CATEGORY ================= -->
    <div class="add-card">
        <h3><i class="fa-solid fa-plus-circle"></i> Add New Category</h3>

        <form asp-controller="Admin" asp-action="AddCategory" method="post" id="addCategoryForm">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Category Name</label>
                <input type="text"
                       name="categoryName"
                       id="categoryNameInput"
                       class="form-control"
                       placeholder="যেমন: Hoodie, Tupi etc."
                       required
                       autocomplete="off"
                       maxlength="100" />
            </div>

            <button type="submit" class="btn-add" id="addBtn">
                <i class="fa-solid fa-plus"></i> Add Category
            </button>
        </form>

        <div class="info-box">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                নতুন ক্যাটাগরি যোগ করলে সেটা <strong>স্বয়ংক্রিয়ভাবে Navbar-এ</strong> দেখাবে।
                চাইলে টগল করে লুকাতে পারবেন।
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            // ==========================================
            // Delete confirmation — product থাকলে ব্লক
            // ==========================================
            window.confirmDelete = function (name, productCount) {
                if (productCount > 0) {
                    alert("'" + name + "' ক্যাটাগরিতে " + productCount +
                          " টি প্রোডাক্ট আছে। আগে সেগুলো অন্য ক্যাটাগরিতে সরান বা ডিলিট করুন।");
                    return false;
                }
                return confirm("আপনি কি নিশ্চিত '" + name + "' ক্যাটাগরি ডিলিট করতে চান?");
            };

            // ==========================================
            // Add form — duplicate submit ব্লক
            // ==========================================
            var form = document.getElementById('addCategoryForm');
            var btn = document.getElementById('addBtn');
            var input = document.getElementById('categoryNameInput');

            if (form && btn) {
                form.addEventListener('submit', function (e) {
                    var val = input ? input.value.trim() : '';
                    if (val.length === 0) {
                        e.preventDefault();
                        alert('ক্যাটাগরির নাম দিন');
                        if (input) input.focus();
                        return;
                    }
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding...';
                });
            }

            // ==========================================
            // Enter key দিয়ে Add — duplicate protection
            // ==========================================
            if (input) {
                input.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        if (form) form.requestSubmit();
                    }
                });
            }
        })();
    </script>
}