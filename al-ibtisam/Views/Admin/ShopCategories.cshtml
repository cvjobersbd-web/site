@model List<al_ibtisam.Models.Category>
@{
    ViewData["Title"] = "Shop Categories";
    ViewData["ActiveNav"] = "ShopCategories";
    ViewData["PageTitle"] = "Shop By Category Management";
    ViewData["PageSubTitle"] = "ক্যাটাগরি এবং আইকন ম্যানেজ করুন (শুধুমাত্র হোম পেজের সাইডবারের জন্য)";
    Layout = "_AdminLayout";
}

<style>
    /* ================= LAYOUT ================= */
    .category-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 24px;
        align-items: flex-start;
    }

    /* ================= LIST CARD ================= */
    .list-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden;
    }
    .list-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef2f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .list-header h2 {
        font-size: 18px;
        font-weight: 700;
        color: #134856;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .list-header h2 i { color: #028EA5; }

    /* ================= TABLE ================= */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    thead { background: #f7fafc; }
    thead th {
        text-align: left;
        padding: 14px 20px;
        font-size: 12.5px;
        font-weight: 700;
        color: #6c8a93;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
        border-bottom: 1px solid #eef2f5;
    }
    tbody tr {
        border-bottom: 1px solid #f4f7fa;
        transition: background .15s;
    }
    tbody tr:hover { background: #f9fbfc; }
    tbody tr:last-child { border-bottom: 0; }
    tbody td {
        padding: 16px 20px;
        color: #134856;
        vertical-align: middle;
    }

    /* ================= CATEGORY CELL ================= */
    .cat-name {
        font-weight: 600;
        font-size: 15px;
        color: #134856;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    
    /* আইকন প্রিভিউ */
    .cat-icon-preview {
        width: 42px;
        height: 42px;
        object-fit: contain;
        border-radius: 8px;
        background: #f7fafc;
        border: 1px solid #e0e6ed;
        padding: 4px;
        flex: 0 0 auto;
    }
    
    /* আইকন না থাকলে ডিফল্ট */
    .cat-icon-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #f0f4f8;
        border: 1px solid #e0e6ed;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a0b2b8;
        font-size: 18px;
        flex: 0 0 auto;
    }

    .order-badge {
        display: inline-block;
        min-width: 30px;
        text-align: center;
        padding: 3px 8px;
        border-radius: 6px;
        background: #f0f4f8;
        color: #6c8a93;
        font-size: 12px;
        font-weight: 600;
    }

    /* ================= ACTION BUTTONS ================= */
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 0;
        cursor: pointer;
        font-size: 14px;
        transition: background .15s, color .15s;
        text-decoration: none;
        flex: 0 0 auto;
    }

    .btn-edit { background: #fff3e0; color: #f57c00; }
    .btn-edit:hover { background: #f57c00; color: #fff; }

    .btn-delete { background: #fdeaea; color: #c62828; }
    .btn-delete:hover { background: #c62828; color: #fff; }

    .actions-cell {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    /* ================= ADD CARD ================= */
    .add-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 24px;
        position: sticky;
        top: 90px;
    }
    .add-card h3 {
        font-size: 16px;
        font-weight: 700;
        color: #134856;
        margin: 0 0 18px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f4f8;
    }
    .add-card h3 i { color: #028EA5; }

    .form-group { margin-bottom: 18px; }
    .form-group label {
        display: block;
        font-size: 13.5px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
    }
    .form-control {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 14px;
        color: #134856;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        font-family: inherit;
        background: #fff;
    }
    .form-control:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }

    /* ================= ICON UPLOAD BOX ================= */
    .img-upload-box {
        border: 2px dashed #b0d4dc;
        border-radius: 10px;
        padding: 22px;
        text-align: center;
        background: #f7fafc;
        cursor: pointer;
        position: relative;
        transition: border-color .2s, background .2s;
    }
    .img-upload-box:hover, .img-upload-box.dragover {
        border-color: #028EA5;
        background: #eaf9fc;
    }
    .img-upload-box input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
        z-index: 2;
    }
    .img-upload-box i {
        font-size: 28px;
        color: #028EA5;
        margin-bottom: 8px;
        display: block;
        pointer-events: none;
    }
    .img-upload-box p {
        margin: 0;
        font-size: 13px;
        color: #134856;
        font-weight: 500;
        pointer-events: none;
    }
    .img-upload-box small {
        font-size: 11.5px;
        color: #6c8a93;
        display: block;
        margin-top: 4px;
        pointer-events: none;
    }

    /* ================= IMAGE PREVIEW ================= */
    .img-preview {
        margin-top: 14px;
        border-radius: 8px;
        overflow: hidden;
        max-width: 100px;
        border: 2px solid #028EA5;
        background: #fff;
        box-shadow: 0 4px 14px rgba(2, 142, 165, .15);
        display: none;
    }
    .img-preview img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* ================= BUTTONS ================= */
    .btn-add {
        width: 100%;
        height: 48px;
        background: #86D200;
        color: #134856;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .2s, color .2s;
        margin-top: 10px;
    }
    .btn-add:hover { background: #134856; color: #fff; }
    .btn-add:disabled { opacity: .7; cursor: not-allowed; }

    /* ================= ALERTS ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
        animation: fadeIn .3s ease;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .alert-success { background: #e3f6ec; border: 1px solid #b3e2c6; color: #0f7b3e; }
    .alert-error { background: #fdeaea; border: 1px solid #f5c2c2; color: #b71c1c; }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 991px) {
        .category-layout { grid-template-columns: 1fr; }
        .add-card { position: static; }
    }
    @@media (max-width: 575px) {
        .list-header { flex-direction: column; align-items: flex-start; }
        thead th, tbody td { padding: 12px; font-size: 13px; }
        .cat-icon-preview, .cat-icon-placeholder { width: 36px; height: 36px; }
    }
</style>

@* ================= ALERTS ================= *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="category-layout">

    <!-- ================= CATEGORY LIST ================= -->
    <div class="list-card">
        <div class="list-header">
            <h2><i class="fa-solid fa-list-ul"></i> Shop Categories</h2>
            <span class="badge" style="background:#e3f2fd; color:#1565c0; padding:6px 14px; border-radius:999px; font-size:12.5px; font-weight:600;">
                মোট @(Model?.Count ?? 0) টি
            </span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Icon & Name</th>
                        <th style="width: 80px;">Order</th>
                        <th style="text-align:right; width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <!-- Icon & Name -->
                                <td>
                                    <div class="cat-name">
                                        @if (!string.IsNullOrEmpty(cat.IconUrl))
                                        {
                                            <img src="@cat.IconUrl" alt="@cat.Name" class="cat-icon-preview" />
                                        }
                                        else
                                        {
                                            <div class="cat-icon-placeholder">
                                                <i class="fa-solid fa-image"></i>
                                            </div>
                                        }
                                        <span>@cat.Name</span>
                                    </div>
                                </td>

                                <!-- Order -->
                                <td>
                                    <span class="order-badge">@cat.DisplayOrder</span>
                                </td>

                                <!-- Actions -->
                                <td style="text-align:right;">
                                    <div class="actions-cell">
                                        <!-- Edit Button -->
                                        <a asp-controller="Admin" asp-action="EditShopCategory" asp-route-id="@cat.Id" class="btn-action btn-edit" title="Edit Category & Icon">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        
                                        <!-- Delete Button -->
                                        <form asp-controller="Admin" asp-action="DeleteShopCategory" method="post" style="margin:0;" onsubmit="return confirm('আপনি কি নিশ্চিত এই ক্যাটাগরিটি ডিলিট করতে চান?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cat.Id" />
                                            <button type="submit" class="btn-action btn-delete" title="Delete Category">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align:center; padding:40px; color:#6c8a93;">
                                <i class="fa-solid fa-box-open" style="font-size:36px; color:#b0d4dc; display:block; margin-bottom:10px;"></i>
                                কোনো ক্যাটাগরি পাওয়া যায়নি।
                                <br />
                                <small style="font-size:12px;">ডান পাশের ফর্ম দিয়ে নতুন ক্যাটাগরি যোগ করুন।</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= ADD NEW CATEGORY ================= -->
    <div class="add-card">
        <h3><i class="fa-solid fa-plus-circle"></i> Add New Category</h3>

        <form asp-controller="Admin" asp-action="AddShopCategory" method="post" enctype="multipart/form-data" id="addCatForm">
            @Html.AntiForgeryToken()

            <!-- Category Name -->
            <div class="form-group">
                <label>Category Name <span style="color:#c62828;">*</span></label>
                <input type="text" 
                       name="categoryName" 
                       id="categoryNameInput" 
                       class="form-control" 
                       placeholder="যেমন: Panjabi, Thobe" 
                       required 
                       autocomplete="off" 
                       maxlength="100" />
            </div>

            <!-- Category Icon -->
            <div class="form-group">
                <label>Category Icon (Image)</label>
                <div class="img-upload-box" id="iconUploadBox">
                    <input type="file" 
                           name="iconFile" 
                           accept="image/*" 
                           id="iconInput" 
                           onchange="previewIcon(this)" />
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <p>ক্লিক করুন অথবা ছবি ড্র্যাগ করুন</p>
                    <small>PNG, JPG, SVG • সর্বোচ্চ 2MB</small>
                </div>
                
                <!-- Image Preview -->
                <div class="img-preview" id="iconPreviewWrap">
                    <img id="iconPreviewImg" src="" alt="Preview" />
                </div>
            </div>

            <button type="submit" class="btn-add" id="addBtn">
                <i class="fa-solid fa-plus"></i> Add Category
            </button>
        </form>

        <div class="info-box" style="margin-top: 20px; background: #f0f9fb; border: 1px solid #b0d4dc; border-radius: 8px; padding: 12px 14px; font-size: 12.5px; color: #134856; line-height: 1.6; display: flex; gap: 10px; align-items: flex-start;">
            <i class="fa-solid fa-circle-info" style="color: #028EA5; font-size: 14px; flex: 0 0 auto; margin-top: 2px;"></i>
            <div>
                এখানে যোগ করা ক্যাটাগরি এবং আইকন শুধুমাত্র হোম পেজের <strong>"Shop By Category"</strong> সাইডবারে দেখাবে।
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // ==========================================
        // Image Preview Function
        // ==========================================
        function previewIcon(input) {
            var previewWrap = document.getElementById('iconPreviewWrap');
            var previewImg = document.getElementById('iconPreviewImg');
            
            if (input.files && input.files[0]) {
                var file = input.files[0];
                
                if (!file.type.startsWith('image/')) {
                    alert('শুধু ইমেজ ফাইল সিলেক্ট করুন');
                    input.value = '';
                    previewWrap.style.display = 'none';
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert('আইকনের সাইজ ২MB এর কম হতে হবে');
                    input.value = '';
                    previewWrap.style.display = 'none';
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewWrap.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                previewWrap.style.display = 'none';
            }
        }

        // ==========================================
        // Drag & Drop Effect
        // ==========================================
        var uploadBox = document.getElementById('iconUploadBox');
        if (uploadBox) {
            ['dragenter', 'dragover'].forEach(function (ev) {
                uploadBox.addEventListener(ev, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadBox.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(function (ev) {
                uploadBox.addEventListener(ev, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadBox.classList.remove('dragover');
                });
            });
        }

        // ==========================================
        // Submit Button Loading State
        // ==========================================
        var form = document.getElementById('addCatForm');
        var btn = document.getElementById('addBtn');
        var nameInput = document.getElementById('categoryNameInput');

        if (form && btn) {
            form.addEventListener('submit', function (e) {
                var val = nameInput ? nameInput.value.trim() : '';
                if (val.length === 0) {
                    e.preventDefault();
                    alert('ক্যাটাগরির নাম দিন');
                    if (nameInput) nameInput.focus();
                    return;
                }
                
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding...';
            });
        }
    </script>
}