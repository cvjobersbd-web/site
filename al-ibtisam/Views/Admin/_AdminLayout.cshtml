@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            background: #f0f4f8;
            color: #134856;
            min-height: 100vh;
        }

        /* ================= LAYOUT ================= */
        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* ================= SIDEBAR ================= */
        .admin-sidebar {
            flex: 0 0 270px;
            width: 270px;
            background: linear-gradient(180deg, #134856 0%, #0a3a48 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1000;
            transition: transform .3s ease;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 24px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            flex: 0 0 auto;
        }

        .sidebar-brand i { color: #86D200; font-size: 26px; }

        .sidebar-brand-text { line-height: 1.2; }

        .sidebar-brand-text strong {
            display: block;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .5px;
            color: #fff;
        }

        .sidebar-brand-text small {
            display: block;
            font-size: 11px;
            color: #86D200;
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* Sidebar user info */
        .sidebar-user {
            padding: 20px 22px;
            display: flex;
            align-items: center;
            gap: 14px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            flex: 0 0 auto;
        }

        .sidebar-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(134, 210, 0, .2);
            border: 2px solid #86D200;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #86D200;
            font-size: 20px;
            flex: 0 0 auto;
        }

        .sidebar-user-info { min-width: 0; flex: 1; }

        .sidebar-user-info small {
            display: block;
            font-size: 11px;
            color: #b0d4dc;
            margin-bottom: 2px;
        }

        .sidebar-user-info strong {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Sidebar menu */
        .sidebar-nav {
            flex: 1 1 auto;
            padding: 12px 0;
            list-style: none;
            margin: 0;
        }

        .sidebar-nav-section {
            padding: 18px 22px 8px;
            font-size: 11px;
            font-weight: 700;
            color: #6c8a93;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .sidebar-nav li { margin: 0; }

        .sidebar-nav a,
        .sidebar-nav button {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 100%;
            padding: 13px 22px;
            background: transparent;
            border: 0;
            border-left: 3px solid transparent;
            text-align: left;
            font-size: 14.5px;
            font-weight: 500;
            color: #d3e7ec;
            text-decoration: none;
            cursor: pointer;
            transition: all .2s;
            font-family: inherit;
        }

        .sidebar-nav a i,
        .sidebar-nav button i {
            width: 20px;
            text-align: center;
            font-size: 16px;
            color: #8ab5c0;
            flex: 0 0 auto;
            transition: color .2s;
        }

        .sidebar-nav a:hover,
        .sidebar-nav button:hover {
            background: rgba(255,255,255,.06);
            color: #fff;
            border-left-color: #86D200;
        }

        .sidebar-nav a:hover i,
        .sidebar-nav button:hover i { color: #86D200; }

        .sidebar-nav a.active {
            background: rgba(134, 210, 0, .12);
            color: #86D200;
            border-left-color: #86D200;
            font-weight: 600;
        }

        .sidebar-nav a.active i { color: #86D200; }

        /* Dropdown Arrow Icon */
        .dropdown-icon {
            margin-left: auto;
            font-size: 12px !important;
            transition: transform 0.3s ease;
            color: #6c8a93 !important;
        }
        
        .has-submenu.open > a .dropdown-icon {
            transform: rotate(180deg);
            color: #86D200 !important;
        }
        
        .has-submenu.open > a {
            color: #86D200;
            background: rgba(255,255,255,.06);
        }

        /* ================= SMOOTH SUB-MENU ================= */
        .sidebar-submenu {
            list-style: none;
            padding: 0;
            margin: 0;
            background: rgba(0, 0, 0, .15);
            
            /* Smooth Animation Magic */
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.35s ease-in-out, opacity 0.3s ease-in-out;
        }
        
        .has-submenu.open .sidebar-submenu {
            max-height: 400px; /* ম্যাক্স হাইট */
            opacity: 1;
        }
        
        .sidebar-submenu a {
            padding-left: 56px;
            font-size: 13.5px;
            color: #a8c7d0;
            padding-top: 11px;
            padding-bottom: 11px;
        }
        
        .sidebar-submenu a::before {
            content: "—";
            margin-right: 8px;
            color: #6c8a93;
            font-size: 12px;
        }
        
        .sidebar-submenu a:hover,
        .sidebar-submenu a.active {
            color: #86D200;
            background: rgba(134, 210, 0, .08);
            border-left-color: transparent;
        }

        /* Sidebar footer / logout */
        .sidebar-footer {
            flex: 0 0 auto;
            padding: 16px 18px;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .sidebar-logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            height: 44px;
            background: rgba(198, 40, 40, .15);
            border: 1px solid rgba(198, 40, 40, .4);
            color: #ff8a8a;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s;
            font-family: inherit;
        }

        .sidebar-logout-btn:hover {
            background: #c62828;
            border-color: #c62828;
            color: #fff;
        }

        /* ================= MAIN AREA ================= */
        .admin-main {
            flex: 1 1 auto;
            margin-left: 270px;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Topbar */
        .admin-topbar {
            background: #fff;
            padding: 16px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
            position: sticky;
            top: 0;
            z-index: 900;
            gap: 16px;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .topbar-toggle {
            display: none;
            background: #f0f4f8;
            border: 0;
            width: 42px;
            height: 42px;
            border-radius: 8px;
            color: #134856;
            font-size: 18px;
            cursor: pointer;
            align-items: center;
            justify-content: center;
        }

        .topbar-title {
            font-size: 20px;
            font-weight: 700;
            color: #134856;
            margin: 0;
        }

        .topbar-sub {
            font-size: 13px;
            color: #6c8a93;
            margin: 2px 0 0;
            font-family: 'Hind Siliguri', sans-serif;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            flex: 0 0 auto;
        }

        .topbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-user-info {
            text-align: right;
            line-height: 1.2;
        }

        .topbar-user-info small {
            display: block;
            font-size: 11px;
            color: #6c8a93;
        }

        .topbar-user-info strong {
            font-size: 14px;
            color: #134856;
        }

        .topbar-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #028EA5, #134856);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex: 0 0 auto;
        }

        /* Page content */
        .admin-content {
            padding: 30px;
            flex: 1 1 auto;
        }

        /* ================= SIDEBAR OVERLAY (Mobile) ================= */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transition: opacity .3s, visibility .3s;
        }

        .sidebar-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
                box-shadow: 4px 0 24px rgba(0,0,0,.2);
            }

            .admin-sidebar.open { transform: translateX(0); }
            .admin-main { margin-left: 0; }
            .topbar-toggle { display: flex; }
            .sidebar-overlay { display: block; }
            .topbar-user-info { display: none; }
            .admin-content { padding: 20px 16px; }
        }

        @@media (max-width: 575.98px) {
            .admin-topbar { padding: 14px 18px; }
            .topbar-title { font-size: 17px; }
            .topbar-sub { font-size: 12px; }
            .admin-content { padding: 16px 12px; }
        }
    </style>
</head>
<body>

    <!-- ================= SIDEBAR OVERLAY ================= -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar" id="adminSidebar">

        <div class="sidebar-brand">
            <i class="fa-solid fa-shield-halved"></i>
            <div class="sidebar-brand-text">
                <strong>AL IBTISAM</strong>
                <small>ADMIN PANEL</small>
            </div>
        </div>

        <div class="sidebar-user">
            <div class="sidebar-avatar">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div class="sidebar-user-info">
                <small>লগইন করা আছে</small>
                <strong>@User.Identity?.Name</strong>
            </div>
        </div>

        <ul class="sidebar-nav">
            <li class="sidebar-nav-section">Main</li>

            <li>
                <a asp-controller="Admin" asp-action="Dashboard"
                   class="@(ViewData["ActiveNav"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="sidebar-nav-section">Management</li>

            <!-- USERS -->
            <li>
                <a asp-controller="Admin" asp-action="Users"
                   class="@(ViewData["ActiveNav"]?.ToString() == "Users" ? "active" : "")">
                    <i class="fa-solid fa-users"></i>
                    <span>Users</span>
                </a>
            </li>

            <!-- 🆕 NAVIGATION MENU -->
            <li>
                <a asp-controller="Admin" asp-action="Navigation"
                   class="@(ViewData["ActiveNav"]?.ToString() == "Navigation" ? "active" : "")">
                    <i class="fa-solid fa-bars"></i>
                    <span>Nav Menus</span>
                </a>
            </li>

            <!-- PRODUCTS & SHOP CATEGORIES (Smooth Animated Submenu) -->
            @{
                // চেক করা হচ্ছে আমরা প্রোডাক্ট বা ক্যাটাগরি পেজে আছি কিনা
                var isProductPage = ViewData["ActiveNav"]?.ToString() == "Products" 
                                    || ViewData["ActiveNav"]?.ToString() == "ProductsList" 
                                    || ViewData["ActiveNav"]?.ToString() == "AddProduct"
                                    || ViewData["ActiveNav"]?.ToString() == "ShopCategories";
            }
            <li class="has-submenu @(isProductPage ? "open" : "")" id="productsMenu">
                <a href="javascript:void(0)" id="productsToggle">
                    <i class="fa-solid fa-box"></i>
                    <span>Products</span>
                    <i class="fa-solid fa-chevron-down dropdown-icon"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="Admin" asp-action="Products"
                           class="@(ViewData["ActiveNav"]?.ToString() == "ProductsList" || ViewData["ActiveNav"]?.ToString() == "Products" ? "active" : "")">
                            All Products
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="AddProduct"
                           class="@(ViewData["ActiveNav"]?.ToString() == "AddProduct" ? "active" : "")">
                            Add New Product
                        </a>
                    </li>
                    <!-- শুধু Shop Categories থাকবে -->
                    <li>
                        <a asp-controller="Admin" asp-action="ShopCategories"
                           class="@(ViewData["ActiveNav"]?.ToString() == "ShopCategories" ? "active" : "")">
                            Shop Categories
                        </a>
                    </li>
                </ul>
            </li>

            <!-- ORDERS -->
            <li>
                <a href="#">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>Orders</span>
                </a>
            </li>

            <li class="sidebar-nav-section">System</li>

            <!-- SETTINGS SUBMENU (Slider & Customize) -->
            @{
                var isSettingsPage = ViewData["ActiveNav"]?.ToString() == "Settings" || ViewData["ActiveNav"]?.ToString() == "Customize";
            }
            <li class="has-submenu @(isSettingsPage ? "open" : "")" id="settingsMenu">
                <a href="javascript:void(0)" id="settingsToggle">
                    <i class="fa-solid fa-gear"></i>
                    <span>Settings</span>
                    <i class="fa-solid fa-chevron-down dropdown-icon"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a asp-controller="Settings" asp-action="Index"
                           class="@(ViewData["ActiveNav"]?.ToString() == "Settings" ? "active" : "")">
                            Slider Setup
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Settings" asp-action="Customize"
                           class="@(ViewData["ActiveNav"]?.ToString() == "Customize" ? "active" : "")">
                            Customize Site
                        </a>
                    </li>
                </ul>
            </li>

            <!-- VISIT STORE -->
            <li>
                <a asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="fa-solid fa-store"></i>
                    <span>Visit Store</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <form asp-controller="Admin" asp-action="SignOut" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ================= MAIN ================= -->
    <div class="admin-main">

        <div class="admin-topbar">
            <div class="topbar-left">
                <button class="topbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div>
                    <h1 class="topbar-title">@(ViewData["PageTitle"] ?? "Dashboard")</h1>
                    <p class="topbar-sub">@(ViewData["PageSubTitle"] ?? "Admin Panel")</p>
                </div>
            </div>

            <div class="topbar-right">
                <div class="topbar-user">
                    <div class="topbar-user-info">
                        <small>Admin</small>
                        <strong>@User.Identity?.Name</strong>
                    </div>
                    <div class="topbar-avatar">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

    <script>
        (function () {
            var sidebar = document.getElementById('adminSidebar');
            var overlay = document.getElementById('sidebarOverlay');
            var sidebarToggle = document.getElementById('sidebarToggle');

            // Mobile Sidebar Toggle
            function openSidebar() {
                if (sidebar) sidebar.classList.add('open');
                if (overlay) overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('show');
                document.body.style.overflow = '';
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function () {
                    if (sidebar.classList.contains('open')) closeSidebar();
                    else openSidebar();
                });
            }

            if (overlay) overlay.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth > 991.98) {
                    closeSidebar();
                }
            });

            // ==========================================
            // Smooth Products Submenu Toggle
            // ==========================================
            var productsMenu = document.getElementById('productsMenu');
            var productsToggle = document.getElementById('productsToggle');

            if (productsToggle) {
                productsToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    productsMenu.classList.toggle('open');
                });
            }

            // ==========================================
            // Smooth Settings Submenu Toggle
            // ==========================================
            var settingsMenu = document.getElementById('settingsMenu');
            var settingsToggle = document.getElementById('settingsToggle');

            if (settingsToggle) {
                settingsToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    settingsMenu.classList.toggle('open');
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>