@model List<al_ibtisam.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - al_ibtisam</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            background: #f0f4f8;
            color: #134856;
            min-height: 100vh;
        }

        /* ================= TOPBAR ================= */
        .admin-topbar {
            background: linear-gradient(135deg, #134856 0%, #0a3a48 100%);
            color: #fff;
            padding: 18px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 12px rgba(0,0,0,.1);
        }
        .admin-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: .5px;
        }
        .admin-logo i {
            color: #86D200;
            font-size: 26px;
        }
        .admin-user {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .admin-user-info {
            text-align: right;
            line-height: 1.2;
        }
        .admin-user-info small {
            display: block;
            font-size: 12px;
            color: #b0d4dc;
        }
        .admin-user-info strong {
            font-size: 15px;
            color: #fff;
        }
        .admin-user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(134, 210, 0, .2);
            border: 2px solid #86D200;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #86D200;
            font-size: 18px;
        }
        .admin-logout-btn {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            color: #fff;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all .2s;
            font-family: inherit;
        }
        .admin-logout-btn:hover {
            background: #c62828;
            border-color: #c62828;
        }

        /* ================= MAIN ================= */
        .admin-main {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
        }

        .admin-page-title {
            font-size: 26px;
            font-weight: 700;
            color: #134856;
            margin-bottom: 6px;
        }
        .admin-page-sub {
            font-size: 14px;
            color: #6c8a93;
            margin-bottom: 28px;
            font-family: 'Hind Siliguri', sans-serif;
        }

        /* ================= STATS ================= */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            display: flex;
            align-items: center;
            gap: 18px;
            transition: transform .2s, box-shadow .2s;
        }
        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,.1);
        }
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            flex: 0 0 auto;
        }
        .stat-icon.blue { background: #e3f2fd; color: #1976d2; }
        .stat-icon.green { background: #e8f5e9; color: #388e3c; }
        .stat-icon.orange { background: #fff3e0; color: #f57c00; }
        .stat-icon.purple { background: #f3e5f5; color: #7b1fa2; }
        .stat-info h3 {
            font-size: 28px;
            font-weight: 700;
            color: #134856;
            margin: 0;
        }
        .stat-info p {
            font-size: 13px;
            color: #6c8a93;
            margin: 4px 0 0 0;
            font-family: 'Hind Siliguri', sans-serif;
        }

        /* ================= TABLE ================= */
        .table-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            overflow: hidden;
        }
        .table-header {
            padding: 22px 26px;
            border-bottom: 1px solid #eef2f5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .table-header h2 {
            font-size: 18px;
            font-weight: 700;
            color: #134856;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .table-header h2 i {
            color: #028EA5;
        }
        .search-user {
            position: relative;
        }
        .search-user input {
            height: 42px;
            padding: 0 40px 0 16px;
            border: 1.5px solid #e0e6ed;
            border-radius: 8px;
            font-size: 14px;
            width: 260px;
            outline: none;
            font-family: inherit;
            transition: border-color .2s;
        }
        .search-user input:focus {
            border-color: #028EA5;
        }
        .search-user i {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c8a93;
            font-size: 14px;
            pointer-events: none;
        }

        .table-wrap {
            overflow-x: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        thead {
            background: #f7fafc;
        }
        thead th {
            text-align: left;
            padding: 14px 18px;
            font-size: 12.5px;
            font-weight: 700;
            color: #6c8a93;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid #eef2f5;
        }
        tbody tr {
            border-bottom: 1px solid #f4f7fa;
            transition: background .15s;
        }
        tbody tr:hover {
            background: #f9fbfc;
        }
        tbody tr:last-child {
            border-bottom: 0;
        }
        tbody td {
            padding: 16px 18px;
            color: #134856;
            vertical-align: middle;
        }
        .user-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #028EA5, #134856);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 16px;
            flex: 0 0 auto;
        }
        .user-name {
            font-weight: 600;
            color: #134856;
            line-height: 1.3;
        }
        .user-id {
            font-size: 12px;
            color: #6c8a93;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }
        .badge-active {
            background: #e8f5e9;
            color: #2e7d32;
        }
        .badge-inactive {
            background: #fdeaea;
            color: #c62828;
        }
        .badge-role {
            background: #e3f2fd;
            color: #1565c0;
        }
        .badge-admin {
            background: #fff3e0;
            color: #e65100;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 0;
            cursor: pointer;
            font-size: 14px;
            transition: background .15s, color .15s;
            text-decoration: none;
        }
        .btn-view { background: #e3f2fd; color: #1976d2; }
        .btn-view:hover { background: #1976d2; color: #fff; }
        .btn-toggle { background: #fff3e0; color: #f57c00; }
        .btn-toggle:hover { background: #f57c00; color: #fff; }
        .btn-delete { background: #fdeaea; color: #c62828; }
        .btn-delete:hover { background: #c62828; color: #fff; }
        .actions-cell {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c8a93;
        }
        .empty-state i {
            font-size: 56px;
            color: #b0d4dc;
            margin-bottom: 16px;
            display: block;
        }
        .empty-state h4 {
            color: #134856;
            margin-bottom: 6px;
        }

        /* ================= ALERTS ================= */
        .alert {
            padding: 14px 20px;
            border-radius: 10px;
            margin-bottom: 22px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Hind Siliguri', sans-serif;
            animation: fadeIn .3s ease;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .alert-success { background: #e3f6ec; border: 1px solid #b3e2c6; color: #0f7b3e; }
        .alert-error { background: #fdeaea; border: 1px solid #f5c2c2; color: #b71c1c; }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 768px) {
            .admin-topbar { padding: 14px 18px; flex-wrap: wrap; gap: 10px; }
            .admin-logo { font-size: 16px; }
            .admin-user-info { display: none; }
            .admin-main { padding: 20px 15px; }
            .admin-page-title { font-size: 20px; }
            .stat-card { padding: 18px; }
            .stat-icon { width: 50px; height: 50px; font-size: 22px; }
            .stat-info h3 { font-size: 22px; }
            .table-header { padding: 16px 18px; }
            .search-user { width: 100%; }
            .search-user input { width: 100%; }
            thead th, tbody td { padding: 12px; font-size: 13px; }
        }
    </style>
</head>
<body>

    <!-- ================= TOPBAR ================= -->
    <div class="admin-topbar">
        <div class="admin-logo">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Admin Panel — AL IBTISAM</span>
        </div>
        <div class="admin-user">
            <div class="admin-user-info">
                <small>লগইন করা আছে</small>
                <strong>@User.Identity?.Name</strong>
            </div>
            <div class="admin-user-avatar">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <form asp-controller="Admin" asp-action="SignOut" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="admin-logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- ================= MAIN ================= -->
    <div class="admin-main">

        <h1 class="admin-page-title">Dashboard</h1>
        <p class="admin-page-sub">সব ইউজারের তথ্য এবং লগইন স্ট্যাটাস এখানে দেখুন</p>

        @* ================= SUCCESS MESSAGE ================= *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @* ================= ERROR MESSAGE ================= *@
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <!-- ================= STATS ================= -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fa-solid fa-users"></i></div>
                <div class="stat-info">
                    <h3>@ViewBag.TotalUsers</h3>
                    <p>মোট ইউজার</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fa-solid fa-user-check"></i></div>
                <div class="stat-info">
                    <h3>@ViewBag.ActiveUsers</h3>
                    <p>সক্রিয় ইউজার</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="fa-solid fa-clock"></i></div>
                <div class="stat-info">
                    <h3>@ViewBag.TodayLogins</h3>
                    <p>আজ লগইন করেছে</p>
                </div>
            </div>
        </div>

        <!-- ================= USER TABLE ================= -->
        <div class="table-card">
            <div class="table-header">
                <h2><i class="fa-solid fa-list"></i> Users List</h2>
                <div class="search-user">
                    <input type="text" id="userSearchInput" placeholder="Search by name, email, phone..." />
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
            </div>

            @if (Model == null || Model.Count == 0)
            {
                <div class="empty-state">
                    <i class="fa-solid fa-users-slash"></i>
                    <h4>কোনো ইউজার নেই</h4>
                    <p>এখনো কেউ সাইন আপ করেনি।</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table id="usersTable">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th>Joined</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var initial = !string.IsNullOrEmpty(user.FullName)
                                    ? user.FullName.Substring(0, 1).ToUpper()
                                    : "?";

                                <tr>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar">@initial</div>
                                            <div>
                                                <div class="user-name">@user.FullName</div>
                                                <div class="user-id">#@user.Id</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@user.Phone</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge badge-admin"><i class="fa-solid fa-crown"></i> Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-role"><i class="fa-solid fa-user"></i> @user.Role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge badge-active"><i class="fa-solid fa-circle-check"></i> Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-inactive"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.LastLoginAt.HasValue)
                                        {
                                            @user.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        }
                                        else
                                        {
                                            <span style="color:#a0b2b8;">Never logged in</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="actions-cell">
                                            <a href="/Admin/UserDetails/@user.Id" class="btn-action btn-view" title="View Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <form asp-controller="Admin" asp-action="ToggleActive" method="post" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-toggle" title="Toggle Active" style="border:0;">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="DeleteUser" method="post" style="margin:0;"
                                                  onsubmit="return confirm('আপনি কি নিশ্চিত এই ইউজারকে ডিলিট করতে চান?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-delete" title="Delete" style="border:0;">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <script>
        // ==========================================
        // Live Search Filter
        // ==========================================
        (function () {
            var input = document.getElementById('userSearchInput');
            var table = document.getElementById('usersTable');
            if (!input || !table) return;

            input.addEventListener('input', function () {
                var q = this.value.toLowerCase().trim();
                var rows = table.querySelectorAll('tbody tr');

                rows.forEach(function (row) {
                    var text = row.textContent.toLowerCase();
                    var show = !q || text.indexOf(q) !== -1;
                    row.style.display = show ? '' : 'none';
                });
            });
        })();
    </script>

</body>
</html>