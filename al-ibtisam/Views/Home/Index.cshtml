        new { Name = "Sneakers",       Img = "https://i.ibb.co.com/9HvJCWkV/7.jpg" },
        new { Name = "Foods",          Img = "https://i.ibb.co.com/SD1j3nRJ/8.jpg" },
        new { Name = "Flash Sale",     Img = "https://i.ibb.co.com/SD1j3nRJ/8.jpg" }
