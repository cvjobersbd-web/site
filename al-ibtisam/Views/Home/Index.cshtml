<section class="tc" aria-label="Top Item">
    <div class="tc-inner">

        <div class="tc-head">
            <h2>Top Item</h2>
        </div>

        <div class="tc-track">
            @foreach (var c in categories)
            {
                <a href="#" class="tc-card" aria-label="@c.Name">
                    <span class="tc-img">
                        <img src="@c.Img" alt="@c.Name" loading="lazy" />
                    </span>
                </a>
            }
        </div>
    </div>
</section>

