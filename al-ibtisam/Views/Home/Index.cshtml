@{
    ViewData["Title"] = "Home Page";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@300;400;600;700&family=Poppins:wght@500;700;800&display=swap" rel="stylesheet" />

<style>
    body {
        overflow-x: hidden;
    }

    /* ================= HERO ================= */
    .hero-wrap {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 18px 15px 14px;
        font-family: 'Poppins', sans-serif;
    }

    .hero {
        max-width: 1620px;
        margin: 0 auto;
        container-type: inline-size;
        display: flex;
        flex-direction: column;
    }

        .hero .carousel-inner {
            border-radius: 14px;
            overflow: hidden;
        }

        .hero .carousel-item {
            aspect-ratio: 1620 / 553;
            transition: opacity .9s ease;
        }

    .hero-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-caption {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: clamp(0px, 7.2cqw, 117px) 20px 0 clamp(20px, 3.2cqw, 52px);
        color: #fff;
        text-align: left;
    }

    .hero-label {
        font-size: clamp(10px, 1cqw, 16px);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: -.2px;
        margin: 0 0 clamp(6px, .7cqw, 12px);
    }

    .hero-title-light {
        font-size: clamp(20px, 3.1cqw, 50px);
        font-weight: 500;
        line-height: 1;
        text-transform: uppercase;
        margin: 0;
    }

    .hero-title-bold {
        font-size: clamp(32px, 5.1cqw, 82px);
        font-weight: 800;
        line-height: 1;
        text-transform: uppercase;
        letter-spacing: -.02em;
        margin: 0;
    }

    .hero-sub {
        font-family: 'League Spartan', 'Poppins', sans-serif;
        font-size: clamp(12px, 1.1cqw, 18px);
        font-weight: 300;
        letter-spacing: .3px;
        margin: clamp(8px, .9cqw, 16px) 0 clamp(14px, 1.8cqw, 34px);
        max-width: 90%;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: clamp(32px, 2.7cqw, 44px);
        padding: 0 clamp(16px, 1.7cqw, 32px);
        background: #fff;
        color: #000;
        font-size: clamp(10px, .65cqw, 11px);
        font-weight: 800;
        letter-spacing: -.2px;
        text-transform: uppercase;
        text-decoration: none;
        transition: background .25s, color .25s;
    }

        .hero-btn:hover {
            background: #000;
            color: #fff;
        }

    .hero .carousel-item.active .hero-anim,
    .hero .carousel-item-next .hero-anim {
        animation: heroSlideIn .8s cubic-bezier(.22, .61, .36, 1) both;
    }

    .hero .carousel-item.active .hero-label, .hero .carousel-item-next .hero-label {
        animation-delay: .15s;
    }

    .hero .carousel-item.active .hero-title-light, .hero .carousel-item-next .hero-title-light {
        animation-delay: .3s;
    }

    .hero .carousel-item.active .hero-title-bold, .hero .carousel-item-next .hero-title-bold {
        animation-delay: .45s;
    }

    .hero .carousel-item.active .hero-sub, .hero .carousel-item-next .hero-sub {
        animation-delay: .6s;
    }

    .hero .carousel-item.active .hero-btn, .hero .carousel-item-next .hero-btn {
        animation-delay: .75s;
    }

    @@keyframes heroSlideIn {
        from {
            opacity: 0;
            transform: translateX(-70px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .hero .carousel-indicators {
        position: static;
        order: 2;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin: 8px 0 0;
    }

        .hero .carousel-indicators [data-bs-target] {
            box-sizing: border-box;
            flex: 0 0 auto;
            width: 12px;
            height: 12px;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background-color: #c9ced4;
            opacity: 1;
            text-indent: -999px;
            transition: background-color .25s;
        }

        .hero .carousel-indicators .active {
            background-color: #0d82f5;
        }

    @@media (max-width: 767.98px) {
        .hero-wrap {
            padding: 10px 10px 8px;
        }

        .hero .carousel-inner {
            border-radius: 10px;
        }

        .hero .carousel-item {
            aspect-ratio: 4 / 3;
        }

            .hero .carousel-item::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(0,0,0,.45), rgba(0,0,0,.05));
                pointer-events: none;
            }

        .hero-caption {
            z-index: 2;
            padding-top: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hero .carousel-item.active .hero-anim,
        .hero .carousel-item-next .hero-anim {
            animation: none;
        }
    }

    /* ================= TOP ITEM ================= */
    .tc {
        --g: clamp(8px, .9vw, 16px);
        --n: 9;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 28px 15px 20px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
        color: #1c1c1c;
    }

    .tc-inner {
        max-width: 1620px;
        margin: 0 auto;
    }

    .tc-head {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(14px, 2.2vw, 40px);
        margin: 0 0 clamp(16px, 1.8vw, 28px);
    }

        .tc-head::before,
        .tc-head::after {
            content: "";
            flex: 1 1 auto;
            max-width: 42%;
            height: 1px;
            background: #d9d9d9;
        }

        .tc-head h2 {
            flex: 0 0 auto;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            font-size: clamp(15px, 1.2vw, 20px);
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            white-space: nowrap;
        }

    .tc-track {
        display: flex;
        gap: var(--g);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        padding: 4px 2px 10px;
    }

        .tc-track::-webkit-scrollbar {
            display: none;
        }

    .tc-card {
        flex: 0 0 calc((100% - (var(--n) - 1) * var(--g)) / var(--n));
        scroll-snap-align: start;
        display: block;
        text-decoration: none;
        color: inherit;
        min-width: 0;
    }

    .tc-img {
        position: relative;
        display: block;
        aspect-ratio: 200 / 235;
        border-radius: 10px;
        overflow: hidden;
        background: #f3f3f3;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
        transition: transform .35s ease, box-shadow .35s ease;
    }

    .tc-card:hover .tc-img {
        transform: translateY(-3px);
        box-shadow: 0 10px 22px rgba(0,0,0,.12);
    }

    .tc-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .7s ease;
    }

    .tc-card:hover .tc-img img {
        transform: scale(1.06);
    }

    @@media (max-width: 1199.98px) {
        .tc {
            --n: 7;
        }
    }

    @@media (max-width: 991.98px) {
        .tc {
            --n: 6;
        }
    }

    @@media (max-width: 767.98px) {
        .tc {
            --n: 4;
            --g: 10px;
            padding: 20px 12px 16px;
        }

        .tc-head::before, .tc-head::after {
            max-width: 25%;
        }
    }

    @@media (max-width: 480px) {
        .tc {
            --n: 3;
            --g: 8px;
        }
    }

    /* ================= SHOWROOM LOCATION BANNER ================= */
    .showroom-banner {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 10px 15px 20px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
    }

    .showroom-inner {
        max-width: 1620px;
        margin: 0 auto;
    }

    .showroom-link {
        display: block;
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .08);
        transition: transform .35s ease, box-shadow .35s ease;
    }

        .showroom-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .14);
        }

        .showroom-link img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
        }

    @@media (max-width: 767.98px) {
        .showroom-banner {
            padding: 8px 12px 16px;
        }

        .showroom-link {
            border-radius: 10px;
        }
    }

    /* ================= JUBBAH SECTION ================= */
    .jb {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 28px 15px 20px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
        color: #1c1c1c;
    }

    .jb-inner {
        max-width: 1620px;
        margin: 0 auto;
    }

    /* Main image */
    .jb-main {
        display: block;
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

        .jb-main img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: cover;
        }

    /* Product grid */
    .jb-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: clamp(10px, 1.1vw, 18px);
    }

    .jb-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        min-width: 0;
    }

    .jb-card-img {
        position: relative;
        display: block;
        aspect-ratio: 3 / 4;
        border-radius: 10px;
        overflow: hidden;
        background: #f3f3f3;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
        transition: transform .35s ease, box-shadow .35s ease;
    }

    .jb-card:hover .jb-card-img {
        transform: translateY(-3px);
        box-shadow: 0 10px 22px rgba(0,0,0,.12);
    }

    .jb-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .7s ease;
    }

    .jb-card:hover .jb-card-img img {
        transform: scale(1.06);
    }

    /* Discount badge */
    .jb-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: #000;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(10px, .75vw, 12px);
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 3px;
        letter-spacing: .3px;
        z-index: 2;
    }

    .jb-card-title {
        margin: 10px 0 2px;
        font-family: 'Poppins', sans-serif;
        font-size: clamp(12px, .85vw, 14px);
        font-weight: 600;
        color: #222;
        line-height: 1.3;
    }

    .jb-card-price {
        margin: 0;
        font-family: 'League Spartan', 'Poppins', sans-serif;
        font-size: clamp(12px, .85vw, 14px);
        font-weight: 700;
        color: #111;
        letter-spacing: .2px;
    }

    @@media (max-width: 991.98px) {
        .jb-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .jb {
            padding: 20px 12px 16px;
        }

        .jb-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .jb-main {
            margin-bottom: 14px;
        }
    }

    @@media (max-width: 420px) {
        .jb-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
    }

    /* ================= FEATURES ================= */
    .ft {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 30px 15px;
        font-family: 'League Spartan', 'Poppins', sans-serif;
    }

    .ft-inner {
        max-width: 1620px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
    }

    .ft-item {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .ft-icon {
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .ft-icon img {
            display: block;
            max-width: 52px;
            max-height: 46px;
            width: auto;
            height: auto;
        }

    .ft-text {
        margin: 0;
        max-width: 340px;
        font-size: clamp(15px, 1vw, 17.5px);
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: .2px;
        color: #555;
    }

        .ft-text strong {
            font-weight: 600;
            color: #333;
        }

    .ft-item.wide .ft-text {
        max-width: 440px;
    }

    @@media (max-width: 991.98px) {
        .ft-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 22px;
        }

        .ft-item.wide .ft-text, .ft-text {
            max-width: none;
        }
    }
</style>

@* Hero Section *@
