@model al_ibtisam.Models.HeroSlide
@{
    ViewData["Title"] = "Edit Hero Slide";
    ViewData["ActiveNav"] = "Settings";
    ViewData["PageTitle"] = "Edit Hero Slide";
    ViewData["PageSubTitle"] = "স্লাইডার ইমেজ ও তথ্য আপডেট করুন";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<style>
    /* ================= FORM CARD ================= */
    .form-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 30px;
        max-width: 760px;
    }

    .form-group { margin-bottom: 20px; }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
    }

    .form-group label .req {
        color: #c62828;
        margin-left: 3px;
    }

    .form-control {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 14px;
        color: #134856;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        font-family: inherit;
        background: #fff;
    }

    .form-control:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }

    textarea.form-control {
        height: 80px;
        padding: 12px 16px;
        resize: vertical;
        line-height: 1.6;
    }

    .form-hint {
        font-size: 12.5px;
        color: #6c8a93;
        margin-top: 5px;
        display: block;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= CURRENT IMAGE BLOCK ================= */
    .current-img-block {
        background: #f0f9fb;
        border: 1.5px solid #b0d4dc;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 14px;
    }

    .current-img-label {
        font-size: 12px;
        font-weight: 700;
        color: #028EA5;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .current-img-block img {
        width: 100%;
        max-width: 500px;
        border-radius: 8px;
        display: block;
        border: 1px solid #e0e6ed;
        background: #f3f3f3;
    }

    /* ================= IMAGE UPLOAD BOX ================= */
    .img-upload-box {
        border: 2px dashed #b0d4dc;
        border-radius: 10px;
        padding: 24px;
        text-align: center;
        background: #f7fafc;
        cursor: pointer;
        position: relative;
        transition: border-color .2s, background .2s;
    }

    .img-upload-box:hover,
    .img-upload-box.dragover {
        border-color: #028EA5;
        background: #eaf9fc;
    }

    .img-upload-box input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
        z-index: 2;
    }

    .img-upload-box i {
        font-size: 28px;
        color: #028EA5;
        margin-bottom: 8px;
        display: block;
        pointer-events: none;
    }

    .img-upload-box p {
        margin: 0;
        font-size: 14px;
        color: #134856;
        font-weight: 500;
        pointer-events: none;
    }

    .img-upload-box small {
        font-size: 12px;
        color: #6c8a93;
        display: block;
        margin-top: 4px;
        pointer-events: none;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= NEW IMAGE PREVIEW ================= */
    .img-preview {
        margin-top: 14px;
        border-radius: 8px;
        overflow: hidden;
        max-width: 500px;
        border: 2px solid #028EA5;
        background: #f3f3f3;
        box-shadow: 0 4px 14px rgba(2, 142, 165, .15);
        position: relative;
    }

    .img-preview img {
        width: 100%;
        height: auto;
        display: block;
    }

    .img-preview .new-tag {
        position: absolute;
        top: 8px;
        left: 8px;
        background: #86D200;
        color: #134856;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 4px;
        letter-spacing: .3px;
    }

    /* ================= TOGGLE SWITCH ================= */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ccc;
        border-radius: 999px;
        transition: background .25s;
    }

    .toggle-slider::before {
        content: "";
        position: absolute;
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform .25s;
        box-shadow: 0 2px 4px rgba(0,0,0,.2);
    }

    .toggle-switch input:checked + .toggle-slider {
        background: #86D200;
    }

    .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(24px);
    }

    .toggle-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: #f7fafc;
        border-radius: 10px;
        border: 1.5px solid #e0e6ed;
    }

    .toggle-row .label-text {
        font-size: 14px;
        font-weight: 600;
        color: #134856;
    }

    .toggle-row .label-text small {
        display: block;
        font-size: 12px;
        color: #6c8a93;
        font-weight: 400;
        margin-top: 2px;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= BUTTONS ================= */
    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        padding-top: 20px;
        border-top: 1px solid #f0f4f8;
        flex-wrap: wrap;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 50px;
        padding: 0 32px;
        background: #028EA5;
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s, transform .1s;
        font-family: inherit;
    }

    .btn-submit:hover { background: #134856; }
    .btn-submit:active { transform: scale(.99); }
    .btn-submit:disabled { opacity: .7; cursor: not-allowed; }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        height: 50px;
        padding: 0 24px;
        background: #e0e6ed;
        color: #134856;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: background .2s;
    }

    .btn-cancel:hover {
        background: #cdd6e0;
        color: #134856;
    }

    /* ================= VALIDATION ================= */
    .field-validation-error {
        color: #c62828;
        font-size: 12.5px;
        margin-top: 5px;
        display: block;
        font-family: 'Hind Siliguri', sans-serif;
    }

    input.input-validation-error,
    select.input-validation-error,
    textarea.input-validation-error {
        border-color: #e57373 !important;
        background: #fff5f5 !important;
    }

    /* ================= ALERT ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
    }

    .alert-error {
        background: #fdeaea;
        border: 1px solid #f5c2c2;
        color: #b71c1c;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 768px) {
        .form-card {
            padding: 20px;
        }

        .btn-row {
            flex-direction: column;
        }

        .btn-submit,
        .btn-cancel {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@* ================= ERROR ALERT ================= *@
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                @error.ErrorMessage
                <br />
            }
        </span>
    </div>
}

<div class="form-card">
    <form asp-controller="Settings"
          asp-action="EditSlide"
          method="post"
          enctype="multipart/form-data"
          novalidate
          id="editSlideForm">
        @Html.AntiForgeryToken()

        @* ================= HIDDEN FIELDS ================= *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="CreatedAt" />

        @* ================= CURRENT IMAGE ================= *@
        <div class="form-group">
            <label>Slide Image</label>

            @* ---- বর্তমান ইমেজ ---- *@
            <div class="current-img-block">
                <span class="current-img-label">
                    <i class="fa-solid fa-image"></i> বর্তমান স্লাইড ইমেজ
                </span>
                <img src="@Model.ImageUrl" alt="Current Slide" />
            </div>

            @* ---- নতুন আপলোড (ঐচ্ছিক) ---- *@
            <div class="img-upload-box" id="imgBox">
                <input type="file"
                       name="imageFile"
                       accept="image/*"
                       id="imageInput" />
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p>নতুন ইমেজ আপলোড করুন (ঐচ্ছিক)</p>
                <small>না দিলে পুরনো ইমেজই থাকবে • JPG / PNG / WEBP • সর্বোচ্চ 5MB</small>
            </div>

            @if (ViewData.ModelState["imageFile"]?.Errors.Count > 0)
            {
                <span class="field-validation-error">
                    @ViewData.ModelState["imageFile"]!.Errors.First().ErrorMessage
                </span>
            }

            @* ---- নতুন ইমেজ প্রিভিউ ---- *@
            <div class="img-preview" id="imgPreview" style="display:none;">
                <span class="new-tag">NEW</span>
                <img id="previewImg" src="" alt="New Preview" />
            </div>
        </div>

        @* ================= TOP LABEL ================= *@
        <div class="form-group">
            <label asp-for="Label">Top Label</label>
            <input asp-for="Label"
                   class="form-control"
                   placeholder="যেমন: New Collection" />
            <span class="form-hint">ঐচ্ছিক — উপরে ছোট করে দেখাবে।</span>
            <span asp-validation-for="Label" class="field-validation-error"></span>
        </div>

        @* ================= TITLE LIGHT ================= *@
        <div class="form-group">
            <label asp-for="TitleLight">Title — Light Line</label>
            <input asp-for="TitleLight"
                   class="form-control"
                   placeholder="যেমন: Fashion" />
            <span class="form-hint">টাইটেলের হালকা/পাতলা লাইন।</span>
            <span asp-validation-for="TitleLight" class="field-validation-error"></span>
        </div>

        @* ================= TITLE BOLD ================= *@
        <div class="form-group">
            <label asp-for="TitleBold">Title — Bold Line</label>
            <input asp-for="TitleBold"
                   class="form-control"
                   placeholder="যেমন: Glasses" />
            <span class="form-hint">টাইটেলের মোটা/বোল্ড লাইন।</span>
            <span asp-validation-for="TitleBold" class="field-validation-error"></span>
        </div>

        @* ================= SUBTITLE ================= *@
        <div class="form-group">
            <label asp-for="Subtitle">Subtitle</label>
            <textarea asp-for="Subtitle"
                      class="form-control"
                      placeholder="যেমন: Best eyeglasses for women to channel your inner Clark Kent"></textarea>
            <span class="form-hint">ঐচ্ছিক — স্লাইডারের নিচে ছোট বর্ণনা।</span>
            <span asp-validation-for="Subtitle" class="field-validation-error"></span>
        </div>

        @* ================= DISPLAY ORDER ================= *@
        <div class="form-group">
            <label asp-for="DisplayOrder">Display Order</label>
            <input asp-for="DisplayOrder"
                   type="number"
                   min="0"
                   class="form-control"
                   style="max-width: 200px;" />
            <span class="form-hint">ছোট সংখ্যা আগে দেখাবে (০, ১, ২...)।</span>
            <span asp-validation-for="DisplayOrder" class="field-validation-error"></span>
        </div>

        @* ================= ACTIVE TOGGLE ================= *@
        <div class="form-group">
            <label>Status</label>
            <div class="toggle-row">
                <label class="toggle-switch">
                    <input asp-for="IsActive" type="checkbox" />
                    <span class="toggle-slider"></span>
                </label>
                <div class="label-text">
                    স্লাইডার সক্রিয়
                    <small>Uncheck করলে হোম পেইজে এই স্লাইড দেখাবে না</small>
                </div>
            </div>
        </div>

        @* ================= SUBMIT ================= *@
        <div class="btn-row">
            <button type="submit" class="btn-submit" id="saveBtn">
                <i class="fa-solid fa-save"></i> Save Changes
            </button>
            <a asp-controller="Settings" asp-action="Index" class="btn-cancel">
                <i class="fa-solid fa-xmark" style="margin-right: 6px;"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {

            // ==========================================
            // 1. NEW IMAGE PREVIEW
            // ==========================================
            var input = document.getElementById('imageInput');
            var preview = document.getElementById('imgPreview');
            var previewImg = document.getElementById('previewImg');

            if (input) {
                input.addEventListener('change', function () {
                    var file = input.files[0];
                    if (!file) {
                        preview.style.display = 'none';
                        return;
                    }

                    // Type check
                    if (!file.type.startsWith('image/')) {
                        alert('শুধু ইমেজ ফাইল সিলেক্ট করুন');
                        input.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    // Size check (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('ইমেজের সাইজ ৫MB এর কম হতে হবে');
                        input.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        preview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                });
            }

            // ==========================================
            // 2. DRAG & DROP EFFECT
            // ==========================================
            var imgBox = document.getElementById('imgBox');
            if (imgBox) {
                ['dragenter', 'dragover'].forEach(function (ev) {
                    imgBox.addEventListener(ev, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        imgBox.classList.add('dragover');
                    });
                });

                ['dragleave', 'drop'].forEach(function (ev) {
                    imgBox.addEventListener(ev, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        imgBox.classList.remove('dragover');
                    });
                });
            }

            // ==========================================
            // 3. SUBMIT + LOADING STATE
            // ==========================================
            var form = document.getElementById('editSlideForm');
            var saveBtn = document.getElementById('saveBtn');

            if (form && saveBtn) {
                form.addEventListener('submit', function (e) {
                    // যদি নতুন ইমেজ সিলেক্ট করা হয় কিন্তু size/type ভুল হয়, সেটা আগেই handle হয়েছে
                    // এখন শুধু loading state
                    saveBtn.disabled = true;
                    saveBtn.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
                });
            }

            // ==========================================
            // 4. AUTO-FOCUS FIRST ERROR
            // ==========================================
            var firstError = document.querySelector('.input-validation-error');
            if (firstError) {
                firstError.focus();
            }

        })();
    </script>
}