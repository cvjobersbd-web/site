@model al_ibtisam.Models.HeroSlide
@{
    ViewData["Title"] = "Add Hero Slide";
    ViewData["ActiveNav"] = "Settings";
    ViewData["PageTitle"] = "Add Hero Slide";
    ViewData["PageSubTitle"] = "নতুন স্লাইডার ইমেজ যোগ করুন";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<style>
    /* ================= FORM CARD ================= */
    .form-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 30px;
        max-width: 760px;
    }

    .form-group { margin-bottom: 20px; }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #134856;
        margin-bottom: 8px;
    }

    .form-group label .req {
        color: #c62828;
        margin-left: 3px;
    }

    /* ================= IMAGE UPLOAD BOX ================= */
    .img-upload-box {
        border: 2px dashed #b0d4dc;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        background: #f7fafc;
        cursor: pointer;
        position: relative;
        transition: border-color .2s, background .2s;
    }

    .img-upload-box:hover,
    .img-upload-box.dragover {
        border-color: #028EA5;
        background: #eaf9fc;
    }

    .img-upload-box input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
        z-index: 2;
    }

    .img-upload-box i {
        font-size: 36px;
        color: #028EA5;
        margin-bottom: 10px;
        display: block;
        pointer-events: none;
    }

    .img-upload-box p {
        margin: 0;
        font-size: 14px;
        color: #134856;
        font-weight: 500;
        pointer-events: none;
    }

    .img-upload-box small {
        font-size: 12px;
        color: #6c8a93;
        display: block;
        margin-top: 4px;
        pointer-events: none;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= IMAGE PREVIEW ================= */
    .img-preview {
        margin-top: 14px;
        border-radius: 8px;
        overflow: hidden;
        max-width: 500px;
        border: 2px solid #028EA5;
        background: #f3f3f3;
        box-shadow: 0 4px 14px rgba(2, 142, 165, .15);
    }

    .img-preview img {
        width: 100%;
        height: auto;
        display: block;
    }

    /* ================= TOGGLE SWITCH ================= */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ccc;
        border-radius: 999px;
        transition: background .25s;
    }

    .toggle-slider::before {
        content: "";
        position: absolute;
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform .25s;
        box-shadow: 0 2px 4px rgba(0,0,0,.2);
    }

    .toggle-switch input:checked + .toggle-slider {
        background: #86D200;
    }

    .toggle-switch input:checked + .toggle-slider::before {
        transform: translateX(24px);
    }

    .toggle-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: #f7fafc;
        border-radius: 10px;
        border: 1.5px solid #e0e6ed;
    }

    .toggle-row .label-text {
        font-size: 14px;
        font-weight: 600;
        color: #134856;
    }

    .toggle-row .label-text small {
        display: block;
        font-size: 12px;
        color: #6c8a93;
        font-weight: 400;
        margin-top: 2px;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= BUTTONS ================= */
    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 10px;
        padding-top: 20px;
        border-top: 1px solid #f0f4f8;
        flex-wrap: wrap;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 50px;
        padding: 0 32px;
        background: #028EA5;
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s, transform .1s;
        font-family: inherit;
    }

    .btn-submit:hover { background: #134856; }
    .btn-submit:active { transform: scale(.99); }
    .btn-submit:disabled { opacity: .7; cursor: not-allowed; }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        height: 50px;
        padding: 0 24px;
        background: #e0e6ed;
        color: #134856;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: background .2s;
    }

    .btn-cancel:hover {
        background: #cdd6e0;
        color: #134856;
    }

    /* ================= VALIDATION ================= */
    .field-validation-error {
        color: #c62828;
        font-size: 12.5px;
        margin-top: 5px;
        display: block;
        font-family: 'Hind Siliguri', sans-serif;
    }

    /* ================= ALERT ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
    }

    .alert-error {
        background: #fdeaea;
        border: 1px solid #f5c2c2;
        color: #b71c1c;
    }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 768px) {
        .form-card {
            padding: 20px;
        }

        .btn-row {
            flex-direction: column;
        }

        .btn-submit,
        .btn-cancel {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@* ================= ERROR ALERT ================= *@
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                @error.ErrorMessage
                <br />
            }
        </span>
    </div>
}

<div class="form-card">
    <form asp-controller="Settings"
          asp-action="AddSlide"
          method="post"
          enctype="multipart/form-data"
          novalidate
          id="addSlideForm">
        @Html.AntiForgeryToken()

        @* ================= IMAGE UPLOAD ================= *@
        <div class="form-group">
            <label>Slide Image <span class="req">*</span></label>

            <div class="img-upload-box" id="imgBox">
                <input type="file"
                       name="imageFile"
                       accept="image/*"
                       id="imageInput" />
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p>ক্লিক করুন অথবা ইমেজ ড্র্যাগ করুন</p>
                <small>Recommended size: 1620 × 553 px • JPG / PNG / WEBP • সর্বোচ্চ 5MB</small>
            </div>

            @if (ViewData.ModelState["imageFile"]?.Errors.Count > 0)
            {
                <span class="field-validation-error">
                    @ViewData.ModelState["imageFile"]!.Errors.First().ErrorMessage
                </span>
            }

            <div class="img-preview" id="imgPreview" style="display:none;">
                <img id="previewImg" src="" alt="Preview" />
            </div>
        </div>

        @* ================= ACTIVE TOGGLE ================= *@
        <div class="form-group">
            <label>Status</label>
            <div class="toggle-row">
                <label class="toggle-switch">
                    <input asp-for="IsActive" type="checkbox" checked />
                    <span class="toggle-slider"></span>
                </label>
                <div class="label-text">
                    স্লাইডার সক্রিয়
                    <small>Uncheck করলে হোম পেইজে এই স্লাইড দেখাবে না</small>
                </div>
            </div>
        </div>

        @* ================= SUBMIT ================= *@
        <div class="btn-row">
            <button type="submit" class="btn-submit" id="saveBtn">
                <i class="fa-solid fa-save"></i> Save Slide
            </button>
            <a asp-controller="Settings" asp-action="Index" class="btn-cancel">
                <i class="fa-solid fa-xmark" style="margin-right: 6px;"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {

            // ==========================================
            // 1. IMAGE PREVIEW
            // ==========================================
            var input = document.getElementById('imageInput');
            var preview = document.getElementById('imgPreview');
            var previewImg = document.getElementById('previewImg');

            if (input) {
                input.addEventListener('change', function () {
                    var file = input.files[0];
                    if (!file) {
                        preview.style.display = 'none';
                        return;
                    }

                    if (!file.type.startsWith('image/')) {
                        alert('শুধু ইমেজ ফাইল সিলেক্ট করুন');
                        input.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    if (file.size > 5 * 1024 * 1024) {
                        alert('ইমেজের সাইজ ৫MB এর কম হতে হবে');
                        input.value = '';
                        preview.style.display = 'none';
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        preview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                });
            }

            // ==========================================
            // 2. DRAG & DROP EFFECT
            // ==========================================
            var imgBox = document.getElementById('imgBox');
            if (imgBox) {
                ['dragenter', 'dragover'].forEach(function (ev) {
                    imgBox.addEventListener(ev, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        imgBox.classList.add('dragover');
                    });
                });

                ['dragleave', 'drop'].forEach(function (ev) {
                    imgBox.addEventListener(ev, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        imgBox.classList.remove('dragover');
                    });
                });
            }

            // ==========================================
            // 3. SUBMIT VALIDATION + LOADING STATE
            // ==========================================
            var form = document.getElementById('addSlideForm');
            var saveBtn = document.getElementById('saveBtn');

            if (form && saveBtn) {
                form.addEventListener('submit', function (e) {
                    if (!input.files.length) {
                        e.preventDefault();
                        alert('স্লাইডার ইমেজ আপলোড করুন');
                        input.focus();
                        return;
                    }

                    saveBtn.disabled = true;
                    saveBtn.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
                });
            }

            // ==========================================
            // 4. AUTO-FOCUS FIRST ERROR
            // ==========================================
            var firstError = document.querySelector('.input-validation-error');
            if (firstError) {
                firstError.focus();
            }

        })();
    </script>
}