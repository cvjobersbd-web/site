@model List<al_ibtisam.Models.HeroSlide>
@{
    ViewData["Title"] = "Settings";
    ViewData["ActiveNav"] = "Settings";
    ViewData["PageTitle"] = "Settings";
    ViewData["PageSubTitle"] = "হোম পেইজের হিরো স্লাইডার ম্যানেজ করুন";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";

    int sliderInterval = ViewBag.SliderInterval ?? 3;
}

<style>
    /* ================= CARD ================= */
    .settings-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        margin-bottom: 24px;
        overflow: hidden;
    }
    .settings-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef2f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }
    .settings-card-header h2 {
        font-size: 18px;
        font-weight: 700;
        color: #134856;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .settings-card-header h2 i { color: #028EA5; }
    .settings-card-body { padding: 24px; }

    /* ================= INTERVAL FORM ================= */
    .interval-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    .interval-label {
        font-size: 14px;
        font-weight: 600;
        color: #134856;
    }
    .interval-input {
        width: 110px;
        height: 48px;
        padding: 0 16px;
        border: 1.5px solid #e0e6ed;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 700;
        color: #134856;
        text-align: center;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        font-family: inherit;
    }
    .interval-input:focus {
        border-color: #028EA5;
        box-shadow: 0 0 0 3px rgba(2, 142, 165, .1);
    }
    .interval-unit {
        font-size: 14px;
        color: #6c8a93;
        font-family: 'Hind Siliguri', sans-serif;
    }
    .btn-save-interval {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 48px;
        padding: 0 22px;
        background: #028EA5;
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s;
        font-family: inherit;
    }
    .btn-save-interval:hover { background: #134856; }

    /* ================= ADD BTN ================= */
    .btn-add-slide {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 42px;
        padding: 0 20px;
        background: #86D200;
        color: #134856;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: background .2s, color .2s;
    }
    .btn-add-slide:hover { background: #134856; color: #fff; }

    /* ================= SLIDE GRID ================= */
    .slides-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }
    .slide-card {
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        border: 1.5px solid #eef2f5;
        transition: transform .2s, box-shadow .2s, opacity .2s;
        display: flex;
        flex-direction: column;
    }
    .slide-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
    }
    .slide-card.inactive {
        opacity: .55;
        border-color: #f5c2c2;
    }
    .slide-img-wrap {
        position: relative;
        aspect-ratio: 16 / 8;
        overflow: hidden;
        background: #f3f3f3;
    }
    .slide-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .slide-status-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        z-index: 2;
    }
    .slide-status-badge.active {
        background: #e8f5e9;
        color: #2e7d32;
    }
    .slide-status-badge.inactive {
        background: #fdeaea;
        color: #c62828;
    }
    .slide-order-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(19, 72, 86, .85);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        z-index: 2;
    }
    .slide-info {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
    }
    .slide-info .label-small {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #028EA5;
        letter-spacing: .5px;
    }
    .slide-info .title-line {
        font-size: 14px;
        font-weight: 600;
        color: #134856;
        line-height: 1.35;
    }
    .slide-info .subtitle-line {
        font-size: 12.5px;
        color: #6c8a93;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .slide-actions {
        display: flex;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid #f4f7fa;
        background: #f9fbfc;
    }
    .slide-actions form { margin: 0; }
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 34px;
        padding: 0 12px;
        border-radius: 6px;
        border: 0;
        cursor: pointer;
        font-size: 12.5px;
        font-weight: 600;
        gap: 6px;
        transition: background .15s, color .15s;
        text-decoration: none;
        font-family: inherit;
    }
    .btn-toggle-slide { background: #fff3e0; color: #f57c00; }
    .btn-toggle-slide:hover { background: #f57c00; color: #fff; }
    .btn-edit-slide { background: #e3f2fd; color: #1976d2; }
    .btn-edit-slide:hover { background: #1976d2; color: #fff; }
    .btn-delete-slide { background: #fdeaea; color: #c62828; margin-left: auto; }
    .btn-delete-slide:hover { background: #c62828; color: #fff; }

    /* ================= EMPTY ================= */
    .empty-slides {
        text-align: center;
        padding: 60px 20px;
        color: #6c8a93;
    }
    .empty-slides i {
        font-size: 56px;
        color: #b0d4dc;
        display: block;
        margin-bottom: 16px;
    }
    .empty-slides h4 { color: #134856; margin: 0 0 6px; font-size: 18px; }
    .empty-slides p { margin: 0 0 18px; font-size: 14px; }

    /* ================= ALERTS ================= */
    .alert {
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 22px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Hind Siliguri', sans-serif;
        animation: fadeIn .3s ease;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .alert-success { background: #e3f6ec; border: 1px solid #b3e2c6; color: #0f7b3e; }
    .alert-error   { background: #fdeaea; border: 1px solid #f5c2c2; color: #b71c1c; }

    /* ================= TOAST ================= */
    .toast-msg {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: #134856;
        color: #fff;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 14px;
        z-index: 9999;
        opacity: 0;
        transition: opacity .25s;
        font-family: 'Hind Siliguri', 'Poppins', sans-serif;
        box-shadow: 0 6px 20px rgba(0,0,0,.2);
    }
    .toast-msg.error { background: #c62828; }

    @@media (max-width: 768px) {
        .settings-card-body { padding: 18px; }
        .interval-row { flex-direction: column; align-items: stretch; }
        .interval-input { width: 100%; }
        .btn-save-interval { width: 100%; justify-content: center; }
        .slides-grid { grid-template-columns: 1fr; }
    }
</style>

@* ================= SUCCESS MESSAGE ================= *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@* ================= ERROR MESSAGE ================= *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@* ================= ANTIFORGERY TOKEN (hidden) ================= *@
<form id="csrfForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- ============================================================ -->
<!-- 1. SLIDER INTERVAL SETTINGS                                  -->
<!-- ============================================================ -->
<div class="settings-card">
    <div class="settings-card-header">
        <h2><i class="fa-solid fa-stopwatch"></i> Slider Speed (Interval)</h2>
    </div>
    <div class="settings-card-body">
        <form asp-controller="Settings" asp-action="UpdateSliderInterval" method="post">
            @Html.AntiForgeryToken()

            <div class="interval-row">
                <span class="interval-label">স্লাইডার কত সেকেন্ড পর পর পরিবর্তন হবে:</span>

                <input type="number"
                       name="interval"
                       class="interval-input"
                       min="1"
                       max="60"
                       value="@sliderInterval"
                       required />

                <span class="interval-unit">সেকেন্ড (১–৬০)</span>

                <button type="submit" class="btn-save-interval">
                    <i class="fa-solid fa-floppy-disk"></i> Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- 2. HERO SLIDES LIST                                          -->
<!-- ============================================================ -->
<div class="settings-card">
    <div class="settings-card-header">
        <h2>
            <i class="fa-solid fa-images"></i>
            Hero Slider Images
            <span style="font-size: 13px; font-weight: 500; color: #6c8a93; background: #f0f4f8; padding: 4px 12px; border-radius: 999px; margin-left: 6px;">
                @(Model?.Count ?? 0) টি
            </span>
        </h2>

        <a asp-controller="Settings" asp-action="AddSlide" class="btn-add-slide">
            <i class="fa-solid fa-plus"></i> Add New Slide
        </a>
    </div>

    <div class="settings-card-body">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-slides">
                <i class="fa-solid fa-images"></i>
                <h4>কোনো স্লাইড নেই</h4>
                <p>হোম পেইজের স্লাইডারে ইমেজ যোগ করতে "Add New Slide" এ ক্লিক করুন।</p>
                <a asp-controller="Settings" asp-action="AddSlide" class="btn-add-slide">
                    <i class="fa-solid fa-plus"></i> Add First Slide
                </a>
            </div>
        }
        else
        {
            <div class="slides-grid" id="slidesGrid">
                @foreach (var slide in Model)
                {
                    <div class="slide-card @(slide.IsActive ? "" : "inactive")"
                         data-id="@slide.Id">
                        <div class="slide-img-wrap">
                            <span class="slide-status-badge @(slide.IsActive ? "active" : "inactive")">
                                @if (slide.IsActive)
                                {
                                    <i class="fa-solid fa-circle-check"></i> <text>Active</text>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-xmark"></i> <text>Inactive</text>
                                }
                            </span>
                            <span class="slide-order-badge">#@slide.DisplayOrder</span>
                            <img src="@slide.ImageUrl" alt="Slide @slide.Id" />
                        </div>

                        <div class="slide-info">
                            @if (!string.IsNullOrEmpty(slide.Label))
                            {
                                <span class="label-small">@slide.Label</span>
                            }
                            @if (!string.IsNullOrEmpty(slide.TitleLight) || !string.IsNullOrEmpty(slide.TitleBold))
                            {
                                <div class="title-line">
                                    @slide.TitleLight @slide.TitleBold
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(slide.Subtitle))
                            {
                                <div class="subtitle-line">@slide.Subtitle</div>
                            }
                        </div>

                        <div class="slide-actions">
                            <button type="button"
                                    class="btn-action btn-toggle-slide"
                                    data-id="@slide.Id"
                                    data-active="@(slide.IsActive ? "true" : "false")">
                                <i class="fa-solid fa-power-off"></i>
                                @(slide.IsActive ? "Deactivate" : "Activate")
                            </button>

                            <a asp-controller="Settings"
                               asp-action="EditSlide"
                               asp-route-id="@slide.Id"
                               class="btn-action btn-edit-slide">
                                <i class="fa-solid fa-pen"></i> Edit
                            </a>

                            <form asp-controller="Settings"
                                  asp-action="DeleteSlide"
                                  method="post"
                                  onsubmit="return confirm('আপনি কি নিশ্চিত এই স্লাইডটি ডিলিট করতে চান?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@slide.Id" />
                                <button type="submit" class="btn-action btn-delete-slide">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tokenEl = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : '';

            function showToast(msg, isError) {
                const t = document.createElement('div');
                t.className = 'toast-msg' + (isError ? ' error' : '');
                t.textContent = msg;
                document.body.appendChild(t);
                requestAnimationFrame(() => { t.style.opacity = '1'; });
                setTimeout(() => {
                    t.style.opacity = '0';
                    setTimeout(() => t.remove(), 300);
                }, 1800);
            }

            // ==========================================
            // Toggle Active — AJAX
            // ==========================================
            document.querySelectorAll('.btn-toggle-slide').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const id = btn.getAttribute('data-id');
                    btn.disabled = true;

                    try {
                        const res = await fetch('/Settings/ToggleActive?id=' + encodeURIComponent(id), {
                            method: 'POST',
                            headers: { 'X-CSRF-TOKEN': token }
                        });
                        const data = await res.json();

                        if (!data.success) {
                            showToast(data.message || 'আপডেট ব্যর্থ', true);
                            return;
                        }

                        // Update card state
                        const card = btn.closest('.slide-card');
                        card.classList.toggle('inactive', !data.isActive);

                        const badge = card.querySelector('.slide-status-badge');
                        badge.className = 'slide-status-badge ' + (data.isActive ? 'active' : 'inactive');
                        badge.innerHTML = data.isActive
                            ? '<i class="fa-solid fa-circle-check"></i> Active'
                            : '<i class="fa-solid fa-circle-xmark"></i> Inactive';

                        btn.innerHTML = data.isActive
                            ? '<i class="fa-solid fa-power-off"></i> Deactivate'
                            : '<i class="fa-solid fa-power-off"></i> Activate';
                        btn.setAttribute('data-active', data.isActive);

                        showToast(data.message);
                    } catch (err) {
                        console.error(err);
                        showToast('সমস্যা হয়েছে', true);
                    } finally {
                        btn.disabled = false;
                    }
                });
            });
        })();
    </script>
}